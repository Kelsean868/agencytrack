# Loaded by the Firebase CLI at deploy time for project agencytrack-staging.
# TENANT ID ONLY - NOT a secret. Committed via an explicit negation in
# .gitignore so a staging deploy is reproducible: without this file the
# endpoint falls back to the PRODUCTION tenant and every staging token
# 401s indistinguishably - the exact failure that made slice B's smoke
# impossible to run on 2026-08-26.
#
# DO NOT put credentials in this file. It is tracked. Secrets belong in
# an untracked .env or Firebase secrets, not here.
AGENCYTRACK_TENANT_ID=staging_test
