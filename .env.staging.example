# AgencyTrack — STAGING environment template
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.staging` (gitignored) and fill with the *agencytrack-staging*
# web-app config from the Firebase Console. NEVER put real values in this
# committed template, and NEVER put production (agencytrack-2a610) values in the
# staging env at all — see docs/runbooks/staging-setup.md and
# scripts/staging/verify-isolation.mjs.
#
# ⛔ ISOLATION RULE: the string "agencytrack-2a610" must appear NOWHERE in your
#    filled-in .env.staging. verify-isolation.mjs FAILS LOUD if it does.
# ─────────────────────────────────────────────────────────────────────────────

# ── Vite / Firebase client config (STAGING project only) ──────────────────────
# All six come from Firebase Console → Project settings → Your apps (Web app) for
# the agencytrack-staging project. projectId MUST be exactly agencytrack-staging.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=agencytrack-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=agencytrack-staging
VITE_FIREBASE_STORAGE_BUCKET=agencytrack-staging.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Kiosk token-validation endpoint (MANDATORY on staging) ────────────────────
# src/lib/kiosk/kioskConfig.js:38-40 falls back to the PRODUCTION Cloud Function
# (…-agencytrack-2a610.cloudfunctions.net/validateKioskToken) when this is unset.
# A staging build that omits this override would call PRODUCTION's CF — a real
# cross-project leak. It MUST be set to the staging CF URL. Region is us-central1
# unless the staging project was created in a different region (see runbook).
VITE_VALIDATE_KIOSK_TOKEN_URL=https://us-central1-agencytrack-staging.cloudfunctions.net/validateKioskToken

# ── Emulator flag — leave UNSET for staging ───────────────────────────────────
# Staging is a real remote Firebase project, not the local emulator. Do NOT set
# VITE_USE_FIREBASE_EMULATOR here; it is only for the local emulator smoke path.
# VITE_USE_FIREBASE_EMULATOR=

# ── Staging seed password (for scripts/staging/seed-staging.mjs) ──────────────
# One throwaway password shared by all synthetic staging_test accounts. This is
# NOT a production credential — it only unlocks fake accounts in the isolated
# staging project. If unset, the seed script uses a documented default and warns.
STAGING_SEED_PASSWORD=

# ── Optional: staging smoke base URL ──────────────────────────────────────────
# The staging Vercel deployment URL, for pointing verification walks at staging.
STAGING_BASE_URL=
