{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "compress": true,
    "removeEmptyLines": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.css",
    "CLAUDE.md",
    "package.json",
    "firestore.rules"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true
  }
}