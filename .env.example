# AgencyTrack environment template
# Copy to .env.local for local development. Never commit real values.

# ── Vite / Firebase client config ─────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Vercel preview bypass token (for protected preview URLs) ──────────────────
VERCEL_BYPASS_TOKEN=

# ── A11y test credentials ─────────────────────────────────────────────────────
# Consumed across scripts/verification/** walks and shakedown harness. Each
# role flavor maps 1:1 to the org hierarchy in CLAUDE.md § Roles & Permissions.
# Only set the role flavors you need locally; scripts gracefully skip checks
# when credentials are absent. Agent + Branch Manager are the minimum for
# standard smoke walks. Do NOT put real platform_admin (Kyron) credentials
# here.
A11Y_AGENT_EMAIL=
A11Y_AGENT_PASSWORD=
A11Y_UNIT_MANAGER_EMAIL=
A11Y_UNIT_MANAGER_PASSWORD=
A11Y_BRANCH_MANAGER_EMAIL=
A11Y_BRANCH_MANAGER_PASSWORD=
A11Y_SALES_MANAGER_EMAIL=
A11Y_SALES_MANAGER_PASSWORD=
A11Y_TENANT_ADMIN_EMAIL=
A11Y_TENANT_ADMIN_PASSWORD=
A11Y_PLATFORM_ADMIN_EMAIL=
A11Y_PLATFORM_ADMIN_PASSWORD=

# Optional: target a specific URL (defaults to http://localhost:5173)
A11Y_BASE_URL=

# ── Admin script credentials ──────────────────────────────────────────────────
# TEST_AGENT_PASSWORD — password for the test agent account (kelsean@gmail.com)
# Used by functions/set-agent-password.cjs. Set in shell before invoking
# (the script does not read .env.local directly; see the script's error message
# for invocation syntax).
TEST_AGENT_PASSWORD=

# ── Kiosk overrides ───────────────────────────────────────────────────────────
# Optional: override the validateKioskToken Cloud Function endpoint. The kiosk
# config (src/lib/kiosk/kioskConfig.js) falls back to the production endpoint
# when this is unset. Set only when targeting a non-default Cloud Functions
# deployment (e.g., a staging project or local emulator).
VITE_VALIDATE_KIOSK_TOKEN_URL=

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable the full planning loop (Money Needs → Year Plan →
# Monthly → Commit). Code default flipped to true in the un-gate PR; keep
# this key in place as an env-var kill-switch after go-live.
VITE_GAME_PLAN_LOOP_ENABLED=
