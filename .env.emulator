# Vite mode env for the local emulator-backed smoke harness.
# Loaded via `vite build --mode emulator` / `vite preview` (or `vite dev --mode emulator`).
# Contains NON-SECRET demo values only — the Firebase emulators do not validate
# credentials. This file is intentionally committed so the smoke harness is
# reproducible. It is NEVER used by the production (Vercel) build.

VITE_USE_FIREBASE_EMULATOR=true
VITE_EMULATOR_AUTH_URL=http://127.0.0.1:9099
VITE_EMULATOR_FIRESTORE_HOST=127.0.0.1
VITE_EMULATOR_FIRESTORE_PORT=9090

# Demo Firebase config — projectId must match the emulator's demo project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-agencytrack.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-agencytrack
VITE_FIREBASE_STORAGE_BUCKET=demo-agencytrack.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demoemulator

# Feature flags ON so smokes can exercise the gated surfaces.
VITE_GAME_PLAN_LOOP_ENABLED=true
VITE_MONEY_NEEDS_MERGED_ENABLED=true