rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return request.auth.token.get('role', '');
    }

    function getTenantId() {
      return request.auth.token.get('tenantId', '');
    }

    function isManager() {
      return getRole() in ['unit_manager', 'branch_manager', 'sales_manager', 'tenant_admin', 'platform_admin'];
    }

    function isAgent() {
      return getRole() == 'agent';
    }

    // Manager-role rank for upline/downline comparisons.
    // Hoisted from block-local *RoleRank copies (cn/jc/war x2) — all were byte-identical.
    function roleRank() {
      return getRole() == 'unit_manager'   ? 1 :
             getRole() == 'branch_manager' ? 2 :
             getRole() == 'sales_manager'  ? 3 :
             getRole() == 'tenant_admin'   ? 4 :
             getRole() == 'platform_admin' ? 5 : 0;
    }

    function canManage(tenantId) {
      return isSignedIn() && (getRole() in ['platform_admin', 'tenant_admin'] || (isManager() && getTenantId() == tenantId));
    }

    function canAccessOwn(tenantId, agentId) {
      return isSignedIn() && (getRole() in ['platform_admin', 'tenant_admin'] || (isAgent() && getTenantId() == tenantId && request.auth.uid == agentId));
    }

    // E5: kiosk display session — read-only, tenant-scoped
    function isKiosk() {
      return getRole() == 'kiosk';
    }

    function kioskCanRead(tenantId) {
      return isSignedIn() && isKiosk() && getTenantId() == tenantId;
    }

    // SEC-4: fetch caller's unitId from Firestore profile (not token — unitId is not a custom claim)
    function callerUnitId(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.unitId;
    }

    // H1.2: legal agent transition guard — mirrors src/constants/policyLifecycle.js.
    // Lapsed is explicitly denied (H2). Terminal states (ntu/denied/settled) have no
    // outbound entries, so the OR chain naturally returns false for them.
    function isLegalAgentTransition(fromStatus, toStatus) {
      return toStatus != 'lapsed'
        && (
          (fromStatus == 'submitted' && toStatus in ['rated', 'postponed', 'ntu', 'denied', 'settled'])
          || (fromStatus == 'rated'     && toStatus in ['settled', 'ntu'])
          || (fromStatus == 'postponed' && toStatus in ['submitted', 'settled', 'denied'])
        );
    }

    // PR-3 (role refactor): cross-tenant audit log of admin account creations.
    // Top-level flat collection. Cloud Function writes via Admin SDK (rules
    // don't apply); clients can never write.
    // Renamed from auditSuperAdminCreations (PR-1/PR-2) to auditAdminCreations (PR-3).
    match /auditAdminCreations/{docId} {
      allow read: if isSignedIn() && (
        getRole() == 'platform_admin' ||
        (getRole() == 'tenant_admin' && resource.data.tenantId == getTenantId())
      );
      allow write: if false;
    }

    // Resend invite audit log — written exclusively by the resendInviteEmail
    // Cloud Function via Admin SDK (rules bypass). Clients never write.
    // Reads: platform_admin unrestricted; tenant_admin / branch_manager /
    // sales_manager scoped to own tenant (matches CF actor set in
    // RESEND_INVITE_ACTOR_ROLES). Mirrors auditAdminCreations rule shape.
    match /auditInviteResends/{docId} {
      allow read: if isSignedIn() && (
        getRole() == 'platform_admin' ||
        (getRole() in ['tenant_admin', 'branch_manager', 'sales_manager'] && resource.data.tenantId == getTenantId())
      );
      allow write: if false;
    }

    // feat(profile): audit log for tenant_admin self-service email changes.
    // Clients create their own entry (scoped by uid + tenantId); no edits or
    // deletes permitted. Mirrors auditAdminCreations read access pattern.
    match /auditAdminEmailUpdates/{docId} {
      allow read: if isSignedIn() && (
        getRole() == 'platform_admin' ||
        (getRole() == 'tenant_admin' && resource.data.tenantId == getTenantId())
      );
      allow create: if isSignedIn()
        && getRole() == 'tenant_admin'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tenantId == getTenantId()
        && request.resource.data.initiatedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // PR-D: mail/ queue for Firebase Trigger Email Extension.
    // All writes come from Cloud Functions via Admin SDK (bypasses rules).
    // No client read or write access — the extension handles delivery.
    match /mail/{docId} {
      allow read, write: if false;
    }

    match /tenants/{tenantId} {

      // PR-1 (user-management): tenant metadata (e.g., enumerated branchIds list
      // for UI dropdowns). Migration script writes via Admin SDK; clients read-only.
      match /meta/{docId} {
        allow read: if isSignedIn() && getTenantId() == tenantId;
        allow write: if false;
      }

      match /users/{userId} {
        // SHAKEDOWN-002: split read into get + list so unit_manager is restricted
        // to their own unit. BM/TA/PA retain full branch/tenant visibility.
        //
        // get: agents/kiosk read own doc; managers read any doc except unit_manager
        //      who can only read own doc or docs in their unit.
        allow get: if kioskCanRead(tenantId)
          || (isSignedIn() && request.auth.uid == userId)
          || (canManage(tenantId) && (
               getRole() != 'unit_manager'
               || request.auth.uid == userId
               || resource.data.unitId == request.auth.uid
             ));
        // list: manager-tier only. unit_manager is restricted to own unit —
        // an unscoped collection query from a UM is denied (defense in depth).
        // Client must include where('unitId','==',callerUid) for UM list reads.
        allow list: if canManage(tenantId) && (
          getRole() != 'unit_manager'
          || resource.data.unitId == request.auth.uid
        );
        // SEC-4: unit_manager can only create/update users within their own unit
        allow create: if canManage(tenantId) && (
          getRole() != 'unit_manager' ||
          callerUnitId(tenantId) == request.resource.data.unitId
        );
        // PR-4: manager-edit path enforces a field allowlist. Closes a pre-existing
        // privilege-laundering vector where any tenant manager could write claim-keyed
        // fields (role, branchId, ownedBranchIds) or audit-immutable fields
        // (createdAt, createdBy, tenantId, email) via direct Firestore updateDoc(),
        // creating divergence between the Firestore role/branchId and the custom
        // claim. Allowlist matches the v1 EditUserDrawer field set.
        //
        // Excluded from this path (must go through Admin SDK / Cloud Functions):
        //   - role, branchId, ownedBranchIds  → custom-claim divergence (PR-4b CF)
        //   - active                          → deactivateUser CF (token revocation)
        //   - email                           → auth-keyed
        //   - uid, tenantId                   → identity / tenant isolation
        //   - createdAt, createdBy, provisioning, csvImportBatchId, importedFromCsv
        //                                     → audit immutability
        allow update: if (canManage(tenantId)
            && (getRole() != 'unit_manager' || callerUnitId(tenantId) == resource.data.unitId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'name', 'phone', 'bio',
                  'unitId', 'unitName',
                  'agentNumber', 'contractStartDate',
                  'canConfirmSettlements',
                  // manager-editable license fields; no CF/claim mirror
                  'licenseStatus', 'cbttExamPassedDate', 'cbttExtensionGranted',
                  'updatedAt', 'updatedBy'
                ])
          ) || (isSignedIn()
            && request.auth.uid == userId
            && (
              (request.auth.token.role == 'unit_manager'
               && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['unitName', 'hasSeenWelcome', 'photoURL', 'bio', 'phone',
                            'loggingMode', 'dailyNudgeTime', 'updatedAt']))
              ||
              request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['hasSeenWelcome', 'photoURL', 'bio', 'phone',
                           'loggingMode', 'dailyNudgeTime', 'updatedAt', 'email'])
            ));
        allow delete: if canManage(tenantId) && getRole() != 'unit_manager';
      }

      // E6: per-agent daily entries. Agent-private — managers continue to
      // see weekly submissions only. Aggregator (Cloud Function) reads via
      // Admin SDK and bypasses rules.
      match /users/{userId}/dailyActivity/{date} {
        allow read, write: if isSignedIn()
          && getTenantId() == tenantId
          && request.auth.uid == userId;
      }

      match /submissions/{submissionId} {
        // unitId is denormalized onto every submission doc at write time.
        //
        // get: resource.data.unitId is available — UM restricted to own-unit
        //      submissions via direct field check (no cross-doc lookup needed).
        // list: resource.data.unitId is available for query evaluation — UM list
        //       queries must include where('unitId','==',callerUid); rule enforces
        //       this, closing the partial defense-in-depth gap from SHAKEDOWN-002B.
        //       BM/TA/PA retain full visibility.
        allow get: if kioskCanRead(tenantId)
          || canAccessOwn(tenantId, resource.data.agentId)
          || (canManage(tenantId) && (
               getRole() != 'unit_manager'
               || resource.data.unitId == request.auth.uid
             ));
        // list: canAccessOwn restored after the SHAKEDOWN-002B read->get/list split
        //       dropped it. resource.data.agentId IS evaluable in list evaluation, so
        //       an agent self-list query — which MUST be constrained
        //       where('agentId','==',uid) — is allowed; any broader/unconstrained agent
        //       query is denied because the other clauses are false for an agent caller.
        //       UM unit-scope clause below is unchanged.
        allow list: if kioskCanRead(tenantId)
          || canAccessOwn(tenantId, resource.data.agentId)
          || (canManage(tenantId) && (
               getRole() != 'unit_manager'
               || resource.data.unitId == request.auth.uid
             ));
        allow create: if canManage(tenantId) || canAccessOwn(tenantId, request.resource.data.agentId);
        allow update: if canManage(tenantId) ||
          (canAccessOwn(tenantId, resource.data.agentId) && resource.data.status == 'draft');
        allow delete: if false;
      }

      // H1: policy ledger — walking skeleton (new collection, no lifecycle).
      // Agent creates + owns entries; managers-in-scope read.
      // unitId + branchId denormalized for UM/BM query filtering (mirrors submissions).
      // Manager two-arm confirmation update is DEFERRED to H1.2.
      match /policies/{policyId} {
        allow get: if canAccessOwn(tenantId, resource.data.agentId)
          || (canManage(tenantId) && (
               getRole() != 'unit_manager'
               || resource.data.unitId == request.auth.uid
             ));
        allow list: if canAccessOwn(tenantId, resource.data.agentId)
          || (canManage(tenantId) && (
               getRole() != 'unit_manager'
               || resource.data.unitId == request.auth.uid
             ));
        allow create: if isSignedIn()
          && isAgent()
          && getTenantId() == tenantId
          && request.resource.data.agentId == request.auth.uid
          && request.resource.data.tenantId == tenantId
          && request.resource.data.status == 'submitted'
          && request.resource.data.sourceOfProspect in [
               'seminar', 'booth-event', 'referral', 'cold-call', 'social-media',
               'orphan', 'existing-client', 'family-friend', 'bank-referral', 'self', 'other'
             ]
          && request.resource.data.dateWritten <= request.time
          && request.resource.data.proposedAPI > 0;
        // Arm A — body-edit (own submitted-status policy, hardened per FU Entry 2).
        // Status must remain 'submitted'; only body fields may change.
        // Value-guards: sourceOfProspect in enum, dateWritten not future, proposedAPI > 0.
        allow update: if isSignedIn()
          && isAgent()
          && getTenantId() == tenantId
          && resource.data.agentId == request.auth.uid
          && resource.data.status == 'submitted'
          && request.resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'ownerName', 'insuredName', 'policyNumber', 'productLine',
               'newBusinessType', 'policyClass', 'planId', 'planName',
               'proposedPremium', 'proposedFrequency', 'proposedAPI',
               'proposedCoverage', 'dateWritten', 'dateSubmitted', 'notes',
               'isSelfOrFamily', 'replacedPolicyAPI',
               'sourceOfProspect', 'cashWithApp'
             ])
          && request.resource.data.sourceOfProspect in [
               'seminar', 'booth-event', 'referral', 'cold-call', 'social-media',
               'orphan', 'existing-client', 'family-friend', 'bank-referral', 'self', 'other'
             ]
          && request.resource.data.dateWritten <= request.time
          && request.resource.data.proposedAPI > 0;

        // Arm B — legal status transition (agent-owned subset of PRD §7).
        // OR'd with Arm A by Firestore. Per-target field sets (H2a loosening #1
        // closed): each target status only allows status + statusUpdatedAt + that
        // status's own fields. Value-guards enforce required fields.
        allow update: if isSignedIn()
          && isAgent()
          && getTenantId() == tenantId
          && resource.data.agentId == request.auth.uid
          && isLegalAgentTransition(resource.data.status, request.resource.data.status)
          && (
            // submitted (re-entry from postponed): no extra fields
            (request.resource.data.status == 'submitted'
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'statusUpdatedAt']))
            || (request.resource.data.status == 'rated'
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'statusUpdatedAt', 'ratedPremium', 'rateReason'])
                && request.resource.data.ratedPremium is number
                && request.resource.data.ratedPremium > 0)
            || (request.resource.data.status == 'postponed'
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'statusUpdatedAt', 'pendingReason']))
            || (request.resource.data.status in ['ntu', 'denied']
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'statusUpdatedAt', 'reason']))
            || (request.resource.data.status == 'settled'
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'statusUpdatedAt',
                               'dateIssued', 'settledAPI', 'issuedCoverage',
                               'initialPremium', 'earnedCommission'])
                && request.resource.data.dateIssued is timestamp
                && request.resource.data.dateIssued >= resource.data.dateWritten
                && request.resource.data.dateIssued <= request.time
                && request.resource.data.settledAPI is number
                && request.resource.data.settledAPI > 0
                && request.resource.data.issuedCoverage is number
                && request.resource.data.issuedCoverage > 0
                && request.resource.data.initialPremium is number
                && request.resource.data.initialPremium > 0
                && request.resource.data.earnedCommission is number
                && request.resource.data.earnedCommission >= 0)
          );

        // Arm C — manager confirmation (H2a). OR'd with Arms A + B by Firestore.
        // Writes the 6 confirmation fields only; never status or any agent field.
        // Gate mirrors the settlements write gate + the existing UM unit-scoping.
        allow update: if isSignedIn()
          && canManage(tenantId)
          && (getRole() in ['platform_admin', 'tenant_admin']
              || getRole() == 'branch_manager'
              || get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.canConfirmSettlements == true)
          && (getRole() != 'unit_manager' || resource.data.unitId == request.auth.uid)
          && resource.data.status == 'settled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'confirmedByManager', 'confirmedByUid', 'confirmedAt',
               'managerSettledAPI', 'managerNote', 'hasDiscrepancy'
             ])
          && request.resource.data.confirmedByUid == request.auth.uid
          && request.resource.data.managerSettledAPI is number
          && request.resource.data.managerSettledAPI > 0
          && request.resource.data.hasDiscrepancy is bool;

        // Arm D — BM-only settled→lapsed (H2c). Explicitly excludes UM and
        // canConfirmSettlements-only callers; only branch_manager / tenant_admin /
        // platform_admin may lapse a policy. OR'd with Arms A/B/C.
        allow update: if isSignedIn()
          && canManage(tenantId)
          && getRole() in ['platform_admin', 'tenant_admin', 'branch_manager']
          && resource.data.status == 'settled'
          && request.resource.data.status == 'lapsed'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'statusUpdatedAt', 'dateLapsed', 'lapseReason'])
          && request.resource.data.dateLapsed is timestamp;

        allow delete: if false;

        // H1.2: policy history subcollection — append-only audit (PRD §7.4).
        // Written only via writeBatch alongside status transitions or confirmation;
        // update/delete are permanently closed.
        match /history/{historyId} {
          allow get: if canAccessOwn(tenantId, resource.data.agentId)
            || (canManage(tenantId) && (
                 getRole() != 'unit_manager'
                 || resource.data.unitId == request.auth.uid
               ));
          allow list: if canAccessOwn(tenantId, resource.data.agentId)
            || (canManage(tenantId) && (
                 getRole() != 'unit_manager'
                 || resource.data.unitId == request.auth.uid
               ));

          // Agent arm: agent writes their own policy's history (H2a loosening #2
          // closed — parent-policy agentId must match the caller, preventing an
          // agent from writing orphan history docs under another agent's policy).
          allow create: if isSignedIn()
            && isAgent()
            && getTenantId() == tenantId
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.agentId == request.auth.uid
            && get(/databases/$(database)/documents/tenants/$(tenantId)/policies/$(policyId)).data.agentId == request.auth.uid
            && request.resource.data.keys().hasAll([
                 'fromStatus', 'toStatus', 'changedFields', 'actorUid',
                 'actorRole', 'at', 'agentId'
               ])
            && isLegalAgentTransition(
                 request.resource.data.fromStatus,
                 request.resource.data.toStatus
               );

          // Manager arm: manager writes a confirmation event (H2a).
          // fromStatus == toStatus == 'settled' is explicitly allowed (confirm
          // is a field-change event, not a lifecycle transition).
          // In-scope check mirrors Arm C: UM restricted to own unit via parent policy;
          // BM/admin tenant-scoped via canManage.
          allow create: if canManage(tenantId)
            && (getRole() in ['platform_admin', 'tenant_admin']
                || getRole() == 'branch_manager'
                || get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.canConfirmSettlements == true)
            && (getRole() != 'unit_manager'
                || get(/databases/$(database)/documents/tenants/$(tenantId)/policies/$(policyId)).data.unitId == request.auth.uid)
            && request.resource.data.actorUid == request.auth.uid
            // H2b: agentId in history doc must match the parent policy's agentId
            // (prevents managers from writing history docs with a forged agentId).
            && request.resource.data.agentId == get(
                 /databases/$(database)/documents/tenants/$(tenantId)/policies/$(policyId)
               ).data.agentId
            && request.resource.data.keys().hasAll([
                 'fromStatus', 'toStatus', 'changedFields', 'actorUid',
                 'actorRole', 'at', 'agentId', 'unitId'
               ]);

          allow update: if false;
          allow delete: if false;
        }
      }

      // E3: persistency — role-scoped by agent's branchId/unitId. Replaces the
      // pre-E3 manager-can-write-anywhere block. Agents can write their own
      // doc (manager wins on collision via app-layer audit-trail precedence).
      // Non-negative validation on the six business inputs is enforced here
      // so the data layer cannot store negative TTD figures.
      match /persistency/{docId} {
        function existingAgentBranchId() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(resource.data.agentId)).data.branchId;
        }
        function existingAgentUnitId() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(resource.data.agentId)).data.unitId;
        }
        function newDocAgentBranchId() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.resource.data.agentId)).data.branchId;
        }
        function callerBranchId() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.branchId;
        }
        function validE3InputsNonNegative() {
          return request.resource.data.businessPlaced  >= 0
              && request.resource.data.notTakens       >= 0
              && request.resource.data.incPPPs         >= 0
              && request.resource.data.lumpsums100     >= 0
              && request.resource.data.lapses          >= 0
              && request.resource.data.reinstatements  >= 0
              && request.resource.data.tenantId == tenantId
              && request.resource.data.lastEditedByRole == getRole()
              && request.resource.data.lastEditedBy == request.auth.uid;
        }

        // allow list is intentionally permissive within tenant scope.
        // Firestore cannot evaluate resource.data for list operations, so
        // per-doc rules (allow get below) handle strict access. Clients
        // must apply where() filters; isE3Doc() in persistencyService.js
        // strips legacy docs before UI render.
        // Trade-off + follow-ups: see SCOPE-2 and PERF-1 in docs/FOLLOW_UPS.md
        // (to be added in a separate post-pilot housekeeping PR).
        allow list: if isSignedIn() && getTenantId() == tenantId;

        allow get: if isSignedIn() && getTenantId() == tenantId && (
          getRole() in ['platform_admin', 'tenant_admin', 'sales_manager']
          // Allow reads of non-existent docs so pre-write getDoc() in savePersistency
          // returns cleanly (doc.exists() === false). No data leakage — resource is null.
          || resource == null
          || (isAgent() && resource.data.agentId == request.auth.uid)
          || (getRole() == 'branch_manager' && existingAgentBranchId() == callerBranchId())
          || (getRole() == 'unit_manager'   && existingAgentUnitId()   == callerUnitId(tenantId))
        );

        allow create, update: if isSignedIn() && getTenantId() == tenantId
          && validE3InputsNonNegative()
          && (
            getRole() in ['platform_admin', 'tenant_admin']
            || (isAgent() && request.resource.data.agentId == request.auth.uid)
            || (getRole() == 'branch_manager' && newDocAgentBranchId() == callerBranchId())
          );

        allow delete: if false;
      }

      match /goals/{goalId} {
        allow read:  if canManage(tenantId) ||
          (isSignedIn() && isAgent() && getTenantId() == tenantId && goalId == request.auth.uid);
        allow write: if canManage(tenantId);
      }

      match /notifications/{notificationId} {
        // SEC-3: add tenant scope to notification reads
        allow read:  if isSignedIn() && getTenantId() == tenantId && (getRole() in ['platform_admin', 'tenant_admin'] || request.auth.uid == resource.data.userId);
        // SEC-10: recipient can mark their own notification read; field-restricted to read/readAt
        allow update: if (isSignedIn() && getTenantId() == tenantId
                         && request.auth.uid == resource.data.userId
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']))
                      || canManage(tenantId);
        allow create, delete: if canManage(tenantId);
      }

      match /leaderboard/{userId} {
        // SEC-2: scope leaderboard reads to own tenant
        allow read:  if isSignedIn() && getTenantId() == tenantId;
        allow write: if canManage(tenantId);
      }

      match /config/{docId} {
        allow read:  if isSignedIn() && getTenantId() == tenantId;
        // SEC: tenant-scope guard. platform_admin is cross-tenant by design;
        // tenant_admin must be writing into their own tenant's config.
        allow write: if isSignedIn()
          && getRole() in ['platform_admin', 'tenant_admin']
          && (getRole() == 'platform_admin' || getTenantId() == tenantId);
      }

      match /settlements/{docId} {
        allow read: if isSignedIn() && (getRole() in ['platform_admin', 'tenant_admin'] || getTenantId() == tenantId);
        allow write: if isSignedIn() && (getRole() in ['platform_admin', 'tenant_admin']
          || getRole() == 'branch_manager'
          || get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.canConfirmSettlements == true);
        allow delete: if isSignedIn() && (getRole() in ['platform_admin', 'tenant_admin']
          || getRole() == 'branch_manager'
          || get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.canConfirmSettlements == true);
      }

      match /unitGoals/{docId} {
        allow read: if request.auth != null
          && request.auth.token.tenantId == tenantId;

        allow write: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role in ['platform_admin', 'tenant_admin']
            || request.auth.token.role == 'branch_manager'
            || request.auth.token.role == 'sales_manager' // BUG-N2: sales_manager has at least branch_manager-level scope per 5-tier hierarchy
            || (
              request.auth.token.role == 'unit_manager'
              // BUG-N fix: use callerUnitId() helper (SEC-4 pattern) — unitId is not a custom claim
              && docId.matches(callerUnitId(tenantId) + '_.*')
            )
          );
      }

      match /branchGoals/{docId} {
        allow read: if request.auth != null
          && request.auth.token.tenantId == tenantId;

        allow write: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role in ['platform_admin', 'tenant_admin']
            || request.auth.token.role == 'branch_manager'
          );
      }

      match /campaigns/{campaignId} {
        allow read: if request.auth != null
          && request.auth.token.tenantId == tenantId;

        allow create: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role in ['platform_admin', 'tenant_admin']
            || request.auth.token.role == 'branch_manager'
            || (
              request.auth.token.role == 'unit_manager'
              && request.resource.data.scope.type == 'unit'
            )
          );

        allow update, delete: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role in ['platform_admin', 'tenant_admin']
            || request.auth.token.role == 'branch_manager'
            || resource.data.createdBy == request.auth.uid
          );
      }

      // Track C C1: branches as a real subcollection under each tenant.
      // tenant_admin / platform_admin CRUD; any signed-in user in the
      // tenant can read for dropdowns. Soft delete only (isActive flag).
      // Per-doc updatedBy + updatedAt audit trail; no separate audit
      // collection until P11. Mirrors the B5 config/{docId} tenant-scope
      // guard pattern.
      match /branches/{branchId} {
        allow read:  if isSignedIn() && getTenantId() == tenantId;
        allow write: if isSignedIn()
          && getRole() in ['platform_admin', 'tenant_admin']
          && (getRole() == 'platform_admin' || getTenantId() == tenantId);
      }

      // E5: kiosk tokens. Manager-tier roles manage tokens; Cloud Function
      // validateKioskToken reads via Admin SDK (bypasses rules entirely).
      match /kioskTokens/{tokenId} {
        allow read, write, delete: if canManage(tenantId);
      }

      // E6: Agent of the Month — manager UI + kiosk display read.
      // Cloud Function writes via Admin SDK (bypasses rules).
      match /agentOfMonth/{monthKey} {
        allow read: if canManage(tenantId) || kioskCanRead(tenantId);
        allow write: if false;
      }

      // F1 (Track F): coaching notes — manager-chain private, agent EXCLUDED.
      //
      // Privacy model: rank-based visibility chain.
      //   authorRoleRank denormalized on each note (UM=1, BM=2, SM=3, TA=4, PA=5).
      //   A caller can read/write only notes authored by someone at or below their rank.
      //   This means UM notes are visible to UM+BM+SM+TA+PA; SM notes to SM+TA+PA only.
      //
      // Scope: unit_manager is restricted to notes where agentUnitId == their uid.
      //   branch_manager and above are tenant-scoped (mirrors the submissions pattern).
      //   Peer-BM exclusion (BM reading notes on an agent in another branch) is a
      //   known limitation — branch-scoped infra not yet built. See FOLLOW_UPS.md.
      //
      // No canAccessOwn branch — the agent NEVER reads their own coaching notes.
      match /users/{agentId}/coachingNotes/{noteId} {

        function cnUMScopeOk() {
          return getRole() != 'unit_manager'
              || resource.data.agentUnitId == request.auth.uid;
        }

        function cnUMScopeOnWrite() {
          return getRole() != 'unit_manager'
              || request.resource.data.agentUnitId == request.auth.uid;
        }

        allow get: if isManager()
          && getTenantId() == tenantId
          && cnUMScopeOk()
          && roleRank() >= resource.data.authorRoleRank;

        // list: evaluated per-document; client MUST include authorRoleRank <= callerRank
        // filter (and agentUnitId == uid for unit_manager). Rule enforces same predicate
        // so unscoped list queries are rejected.
        allow list: if isManager()
          && getTenantId() == tenantId
          && (getRole() != 'unit_manager' || resource.data.agentUnitId == request.auth.uid)
          && roleRank() >= resource.data.authorRoleRank;

        allow create: if isManager()
          && getTenantId() == tenantId
          && cnUMScopeOnWrite()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRoleRank == roleRank()
          && request.resource.data.tenantId == tenantId
          && request.resource.data.agentId == agentId
          && request.resource.data.category in
               ['observation', 'goal', 'concern', 'win', 'action_item']
          && request.resource.data.keys().hasAll([
               'agentId', 'tenantId', 'agentUnitId', 'authorUid',
               'authorName', 'authorRole', 'authorRoleRank', 'category',
               'body', 'createdAt', 'updatedAt'
             ]);

        // update: author may edit their own note body/category only (no rank change, no delete).
        allow update: if isManager()
          && getTenantId() == tenantId
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['body', 'category', 'updatedAt'])
          && request.resource.data.category in
               ['observation', 'goal', 'concern', 'win', 'action_item'];

        allow delete: if false;
      }

      // F3 (Track F): prospect-info — agent-authored, manager-chain READABLE.
      //
      // Privacy model: SUBMISSIONS-style (NOT F1/F2's exclusion).
      //   - Agent owns/reads/edits OWN records (request.auth.uid == path agentId).
      //   - Managers in scope READ; managers do NOT write.
      //
      // Scope: unit_manager restricted to docs where agentUnitId == their uid;
      //   branch_manager and above tenant-scoped (mirrors the submissions rule).
      //
      // Path-bound: {agentId} appears in path, so agent-own checks compare the
      //   path segment to request.auth.uid directly (no resource.data lookup).
      //
      // Inversion vs F1/F2: NOT rank-based, NOT agent-excluded. The agent IS
      //   the author and CAN read their own. Managers CANNOT write.
      match /users/{agentId}/prospectInfo/{prospectId} {

        // get: agent reads own (path agentId == uid), OR manager reads in scope.
        allow get: if isSignedIn() && getTenantId() == tenantId && (
          request.auth.uid == agentId
          || (isManager() && (
               getRole() != 'unit_manager'
               || resource.data.agentUnitId == request.auth.uid
             ))
        );

        // list: agent lists own (path agentId == uid), OR manager lists in scope.
        // For UM the rule enforces agentUnitId == request.auth.uid per-doc, so
        // the client query MUST include where('agentUnitId','==',callerUid).
        allow list: if isSignedIn() && getTenantId() == tenantId && (
          request.auth.uid == agentId
          || (isManager() && (
               getRole() != 'unit_manager'
               || resource.data.agentUnitId == request.auth.uid
             ))
        );

        // create: agent-only, must match path agentId. Managers DENIED.
        allow create: if isSignedIn()
          && getTenantId() == tenantId
          && isAgent()
          && request.auth.uid == agentId
          && request.resource.data.agentId == agentId
          && request.resource.data.tenantId == tenantId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.prospectingSource in
               ['seminar', 'booth-event', 'referral', 'cold-call', 'social-media',
                'orphan', 'existing-client', 'family-friend',
                'bank-referral', 'BOA', 'self', 'other']
          && request.resource.data.appointmentType in
               ['2nd-interview', 'closing-interview']
          && request.resource.data.objections is list
          && request.resource.data.keys().hasAll([
               'agentId', 'tenantId', 'agentUnitId', 'createdBy',
               'clientName', 'prospectingSource', 'appointmentType',
               'objections', 'policyType', 'intendedAppointmentDate',
               'createdAt', 'updatedAt'
             ]);

        // update: agent-only, must own path. Body-shape fields only;
        //   never agentId/tenantId/createdBy/agentUnitId/audit timestamps (except updatedAt).
        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && isAgent()
          && request.auth.uid == agentId
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'clientName', 'clientAge', 'clientOccupation',
                 'prospectingSource', 'appointmentType', 'objections',
                 'policyType', 'intendedAppointmentDate', 'updatedAt'
               ])
          && request.resource.data.prospectingSource in
               ['seminar', 'booth-event', 'referral', 'cold-call', 'social-media',
                'orphan', 'existing-client', 'family-friend',
                'bank-referral', 'BOA', 'self', 'other']
          && request.resource.data.appointmentType in
               ['2nd-interview', 'closing-interview']
          && request.resource.data.objections is list;

        // No deletes (agent-immutable history); soft-delete is a future change.
        allow delete: if false;
      }

      // F2 (Track F): joint-call observations — manager-chain private, agent EXCLUDED.
      //
      // Privacy model: identical to F1 coachingNotes (rank-based visibility chain).
      //   authorRoleRank denormalized on each call (UM=1, BM=2, SM=3, TA=4, PA=5).
      //   A caller can read/write only calls authored by someone at or below their rank.
      //
      // Scope: unit_manager is restricted to calls where agentUnitId == their uid.
      //   branch_manager and above are tenant-scoped (mirrors F1).
      //
      // No canAccessOwn branch — the agent NEVER reads their own joint-call observations.
      match /users/{agentId}/jointCalls/{callId} {

        function jcUMScopeOk() {
          return getRole() != 'unit_manager'
              || resource.data.agentUnitId == request.auth.uid;
        }

        function jcUMScopeOnWrite() {
          return getRole() != 'unit_manager'
              || request.resource.data.agentUnitId == request.auth.uid;
        }

        allow get: if isManager()
          && getTenantId() == tenantId
          && jcUMScopeOk()
          && roleRank() >= resource.data.authorRoleRank;

        // list — TWO separate allow declarations (ORed by Firestore, each evaluated independently):
        //
        // 1. Author arm (collectionGroup-safe, I1.2): caller reads their OWN authored calls.
        //    Split into its own allow list so Firestore evaluates it in isolation.
        //    A combined || with arm 2 (which has a path-variable condition) causes production
        //    Firestore to reject the entire expression for collectionGroup queries — it cannot
        //    short-circuit OR when any arm is statically unverifiable. Separate declarations
        //    are each evaluated independently; if arm 1 satisfies the query, access is granted
        //    regardless of arm 2. Tenant isolation is enforced at the query level:
        //    getOwnJfwCount includes where('tenantId','==',tid) and the create-rule invariant
        //    (authorUid pinned + tenantId field == path tenantId) guarantees a uid can only
        //    author docs in its own tenant.
        allow list: if isManager()
          && resource.data.authorUid == request.auth.uid;

        // 2. Upline rank-scoped list (collection-scoped only): upline manager lists an agent's calls.
        //    getTenantId()==tenantId uses a path variable — safe only for COLLECTION queries
        //    (single-agent path). Never used as collectionGroup; the author arm above handles that.
        allow list: if isManager()
          && getTenantId() == tenantId
          && (getRole() != 'unit_manager' || resource.data.agentUnitId == request.auth.uid)
          && roleRank() >= resource.data.authorRoleRank;

        allow create: if isManager()
          && getTenantId() == tenantId
          && jcUMScopeOnWrite()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRoleRank == roleRank()
          && request.resource.data.tenantId == tenantId
          && request.resource.data.agentId == agentId
          && request.resource.data.meetingType in
               ['demonstration', 'observation', 'collaboration']
          && request.resource.data.needCovered in
               ['income_protection', 'mortgage_or_debt', 'education_funding',
                'retirement_planning', 'final_expenses', 'wealth_accumulation',
                'critical_illness_or_health', 'business_protection', 'other']
          && request.resource.data.keys().hasAll([
               'agentId', 'tenantId', 'agentUnitId', 'authorUid',
               'authorName', 'authorRole', 'authorRoleRank',
               'appointmentDate', 'appointmentTime', 'appointmentKept',
               'nextMeetingDate', 'meetingType', 'needCovered',
               'comments', 'saleMade', 'coachingMinutes', 'trainingIdentified',
               'createdAt', 'updatedAt'
             ]);

        // update: author may edit body-shape fields only; never authorUid/rank/audit/agent identity.
        allow update: if isManager()
          && getTenantId() == tenantId
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'appointmentDate', 'appointmentTime', 'appointmentKept',
                 'nextMeetingDate', 'meetingType', 'needCovered',
                 'comments', 'saleMade', 'coachingMinutes', 'trainingIdentified',
                 'prospectInfoId',
                 'updatedAt'
               ])
          && request.resource.data.meetingType in
               ['demonstration', 'observation', 'collaboration']
          && request.resource.data.needCovered in
               ['income_protection', 'mortgage_or_debt', 'education_funding',
                'retirement_planning', 'final_expenses', 'wealth_accumulation',
                'critical_illness_or_health', 'business_protection', 'other'];

        allow delete: if false;
      }

      // Track I I1.1: Manager Weekly Activity Report.
      // Privacy model (submissions-direction, NOT coaching-notes-direction):
      //   - Owner (the filing manager) creates, updates, and reads their own WAR.
      //   - Upline reads read-only: reader rank strictly > WAR's managerRoleRank,
      //     with BM limited to same branchId; SM+ tenant-wide.
      //     SM=tenant-wide is valid while SM≈head-of-sales in a single-branch org.
      //   - Peers (same/lower rank) and downline agents are DENIED.
      //   - Filers: unit_manager, branch_manager, sales_manager.
      //     tenant_admin / platform_admin read-only; they do not file a WAR.
      // No collectionGroup query and no index in this PR (I1.1).
      // I1.2 adds jfwCount auto-count via collectionGroup + index.
      match /managerWeeklyReports/{warId} {

        // SEC-4 pattern: branchId is not a custom claim; read from Firestore user doc.
        function callerBranchId(tenantId) {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.branchId;
        }

        // Upline-in-scope: strictly greater than to deny peers.
        function uplineCanRead() {
          return roleRank() > resource.data.managerRoleRank
            && (
              getRole() in ['tenant_admin', 'platform_admin', 'sales_manager']
              || (getRole() == 'branch_manager'
                  && callerBranchId(tenantId) == resource.data.branchId)
            );
        }

        // Field-shape validation. jfwCount: on create must be 0; on update client
        // cannot change it (I1.2 auto-count writes via Admin SDK bypassing rules).
        function validWarWrite() {
          let d = request.resource.data;
          return d.managerId == request.auth.uid
            && d.tenantId == tenantId
            && d.keys().hasAll([
                 'managerId', 'tenantId', 'weekStart',
                 'managerRole', 'managerRoleRank', 'branchId', 'unitId',
                 'oneOnOnesConducted', 'namesSourced', 'interviewsConducted',
                 'recruitsInFirstWeeks', 'trainingSessions', 'trainingTopic',
                 'unitMeetingHeld', 'dashboardReviewDone',
                 'jfwCount', 'status', 'updatedAt'
               ])
            && d.oneOnOnesConducted   is int
            && d.namesSourced         is int
            && d.interviewsConducted  is int
            && d.recruitsInFirstWeeks is int
            && d.trainingSessions     is int
            && d.trainingTopic        is string
            && d.dashboardReviewDone  is bool
            && d.unitMeetingHeld      is bool
            && d.jfwCount == (resource == null ? 0 : resource.data.jfwCount)
            && d.status in ['draft', 'submitted']
            && d.weekStart is string
            && d.managerRole in ['unit_manager', 'branch_manager', 'sales_manager']
            && d.managerRoleRank == roleRank();
        }

        allow create: if isSignedIn()
          && getTenantId() == tenantId
          && getRole() in ['unit_manager', 'branch_manager', 'sales_manager']
          && validWarWrite();

        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && resource.data.managerId == request.auth.uid
          && validWarWrite();

        // Single-doc: owner (or pre-write existence check via warId prefix) OR upline.
        // resource == null when doc doesn't exist (owner's pre-write getDoc check).
        // Extract managerId from warId (format: {managerId}_{weekStart}) to allow
        // owner existence-check without hitting a null-pointer on resource.data.
        allow get: if isSignedIn()
          && getTenantId() == tenantId
          && (resource == null
              ? warId.split('_')[0] == request.auth.uid
              : resource.data.managerId == request.auth.uid || uplineCanRead());

        // Query-safe list: BM (rank 2) sees own branch; SM+ (rank ≥ 3) sees tenant-wide.
        // UM (rank 1) denied by the roleRank()>=2 gate. roleRank() and
        // callerBranchId() are block-local — no hoisting needed (I1.x FU).
        allow list: if getTenantId() == tenantId
          && roleRank() >= 2
          && (resource.data.branchId == callerBranchId(tenantId) || roleRank() >= 3);

        allow delete: if false;
      }

      // ── I2: manager monthly recruiting roll-up ───────────────────────────────
      // /tenants/{tid}/managerMonthlyRollups/{managerId}_{YYYY_MM}
      // Privacy = WAR direction: owner RW, upline R; peers + downline DENY.
      // callerBranchId + uplineCanRead are block-local (mirror managerWeeklyReports
      // at :651/:656) — they scope tenantId from the surrounding match block.
      // No jfwCount-immutability analog (no CF auto-count for monthly fields).
      match /managerMonthlyRollups/{rollupId} {

        function callerBranchId(tenantId) {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.branchId;
        }

        function uplineCanRead() {
          return roleRank() > resource.data.managerRoleRank
            && (
              getRole() in ['tenant_admin', 'platform_admin', 'sales_manager']
              || (getRole() == 'branch_manager'
                  && callerBranchId(tenantId) == resource.data.branchId)
            );
        }

        function validRollupWrite() {
          let d = request.resource.data;
          return d.managerId == request.auth.uid
            && d.tenantId == tenantId
            && d.keys().hasAll([
                 'managerId', 'tenantId', 'monthKey',
                 'managerRole', 'managerRoleRank', 'branchId', 'unitId',
                 'candidatesAssessed', 'agentsContracted',
                 'status', 'updatedAt'
               ])
            && d.candidatesAssessed is int && d.candidatesAssessed >= 0
            && d.agentsContracted   is int && d.agentsContracted   >= 0
            && d.status in ['draft', 'submitted']
            && d.monthKey is string
            && d.managerRole in ['unit_manager', 'branch_manager', 'sales_manager']
            && d.managerRoleRank == roleRank();
        }

        allow create: if isSignedIn() && getTenantId() == tenantId
          && getRole() in ['unit_manager', 'branch_manager', 'sales_manager']
          && validRollupWrite();

        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && resource.data.managerId == request.auth.uid
          && validRollupWrite();

        // Single-doc: owner (or pre-write existence check via rollupId prefix) OR upline.
        // resource == null when doc doesn't exist (owner's pre-write getDoc check).
        // Extract managerId from rollupId (format: {managerId}_{YYYY-MM}) to allow
        // owner existence-check without hitting a null-pointer on resource.data.
        allow get: if isSignedIn() && getTenantId() == tenantId
          && (resource == null
              ? rollupId.split('_')[0] == request.auth.uid
              : resource.data.managerId == request.auth.uid || uplineCanRead());

        // Query-safe list: BM (rank 2) sees own branch; SM+ (rank ≥ 3) sees tenant-wide.
        // UM (rank 1) denied by the roleRank()>=2 gate.
        allow list: if isSignedIn() && getTenantId() == tenantId
          && roleRank() >= 2
          && (resource.data.branchId == callerBranchId(tenantId) || roleRank() >= 3);

        allow delete: if false;
      }

      // ── I1.3c-ii: per-manager activity standard overrides ────────────────────
      // /tenants/{tid}/managerActivityStandardOverrides/{managerId}
      // Fields: tenantId, managerId, updatedBy, updatedAt, + partial activity map.
      // NO branchId/role denormalization — rule reads M's real role+branchId via
      // get(M's user doc) to prevent forgery (request.resource.data fields about
      // M are controllable by the writer; resource.data is null on create).
      // get(M) via subjectData(): Firestore caches same-path get() within one
      // rule evaluation, so subjectRank() + subjectBranchId() cost one read.
      match /managerActivityStandardOverrides/{managerId} {

        // Caller's branchId via get() — branchId is not a claim (SEC-4 pattern).
        function callerBranchId(tenantId) {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.branchId;
        }

        // Subject (M)'s real role + branchId from M's user doc.
        // managerId == M's uid (the doc path ID).
        function subjectData() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(managerId)).data;
        }

        function subjectRank() {
          let r = subjectData().role;
          return r == 'unit_manager'   ? 1 :
                 r == 'branch_manager' ? 2 :
                 r == 'sales_manager'  ? 3 : 0;
        }

        function subjectBranchId() {
          return subjectData().branchId;
        }

        // Upline-in-scope: strictly greater rank (denies peers + self); BM branch-scoped.
        function uplineInScope() {
          return roleRank() > subjectRank()
            && (roleRank() >= 3
                || (getRole() == 'branch_manager'
                    && callerBranchId(tenantId) == subjectBranchId()));
        }

        // Owner reads own (uid == managerId — no resource access needed, handles null doc).
        // Upline reads by id when browsing M's WAR. No list rule.
        allow get: if isSignedIn()
          && getTenantId() == tenantId
          && (request.auth.uid == managerId || uplineInScope());

        // Payload managerId + tenantId validated against path/tenant.
        // Subject rank + branch from get(M), NOT request.resource.data — forgery prevention.
        allow create: if isSignedIn()
          && getTenantId() == tenantId
          && request.resource.data.managerId == managerId
          && request.resource.data.tenantId  == tenantId
          && uplineInScope();

        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && uplineInScope();

        // Delete reverts M to org-defaults (clears entire override doc).
        allow delete: if isSignedIn()
          && getTenantId() == tenantId
          && uplineInScope();

        allow list: if false;
      }

      // G5: Money Needs Worksheet — agent-own + manager-read arms (opt-in consent model).
      match /users/{uid}/moneyNeeds/{year} {
        // Owner: full read/write
        allow get, list: if canAccessOwn(tenantId, uid);

        // UM: read if shared AND same unit
        allow get, list: if canManage(tenantId)
          && getRole() == 'unit_manager'
          && resource.data.visibility == 'shared'
          && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(uid)).data.unitId == callerUnitId(tenantId);

        // BM: read if shared
        allow get, list: if canManage(tenantId)
          && getRole() == 'branch_manager'
          && resource.data.visibility == 'shared';

        // SM: read if shareWithSm
        allow get, list: if canManage(tenantId)
          && getRole() == 'sales_manager'
          && resource.data.shareWithSm == true;

        // Tenant admin: read if shared OR shareWithSm
        allow get, list: if canManage(tenantId)
          && getRole() == 'tenant_admin'
          && (resource.data.visibility == 'shared' || resource.data.shareWithSm == true);

        // Create: owner, must start private
        allow create: if canAccessOwn(tenantId, uid)
          && request.resource.data.visibility == 'private';

        // Update: owner only (agent controls visibility)
        allow update: if canAccessOwn(tenantId, uid);

        // BM update: only allowed to flip shareWithSm field
        allow update: if canManage(tenantId)
          && getRole() == 'branch_manager'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareWithSm', 'updatedAt', 'updatedBy']);

        allow delete: if false;
      }

    }

    // ── I1.2: collectionGroup author arm for jointCalls ───────────────────────
    // Firestore collectionGroup query security requires a top-level recursive
    // wildcard match; path-specific rules (match /tenants/.../jointCalls/{id})
    // are not reliably evaluated for collectionGroup queries. This rule handles
    // ONLY the author-arm list (manager reads their own authored calls via the
    // getOwnJfwCount collectionGroup query). All other jointCalls operations
    // (get, create, update, delete, upline list) remain governed by the specific
    // path rule inside match /tenants/{tenantId}/users/{agentId}/jointCalls/{callId}.
    //
    // Tenant isolation: enforced at query level — getOwnJfwCount always includes
    // where('tenantId','==',tenantId). The create-rule invariant (authorUid pinned
    // + tenantId field == path tenantId) guarantees a manager can only author docs
    // in their own tenant, providing defense-in-depth against cross-tenant reads.
    match /{path=**}/jointCalls/{callId} {
      allow list: if isManager()
        && resource.data.authorUid == request.auth.uid;
    }

  }
}
