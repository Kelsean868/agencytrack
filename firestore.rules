rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return request.auth.token.get('role', '');
    }

    function getTenantId() {
      return request.auth.token.get('tenantId', '');
    }

    function isManager() {
      return getRole() in ['unit_manager', 'branch_manager', 'super_admin'];
    }

    function isAgent() {
      return getRole() == 'agent';
    }

    function isSuperAdminUID() {
      return request.auth.uid == '4GeeZbhZBwdtGOLoJoggf4MQo142';
    }

    function canManage(tenantId) {
      return isSignedIn() && (isSuperAdminUID() || (isManager() && getTenantId() == tenantId));
    }

    function canAccessOwn(tenantId, agentId) {
      return isSignedIn() && (isSuperAdminUID() || (isAgent() && getTenantId() == tenantId && request.auth.uid == agentId));
    }

    match /tenants/{tenantId} {

      match /users/{userId} {
        allow read, write: if canManage(tenantId) || (isSignedIn() && request.auth.uid == userId);
      }

      match /submissions/{submissionId} {
        allow read:   if canManage(tenantId) || canAccessOwn(tenantId, resource.data.agentId);
        allow create: if canManage(tenantId) || canAccessOwn(tenantId, request.resource.data.agentId);
        allow update: if canManage(tenantId) ||
          (canAccessOwn(tenantId, resource.data.agentId) && resource.data.status == 'draft');
        allow delete: if false;
      }

      match /persistency/{docId} {
        allow read: if canManage(tenantId) ||
          (isSignedIn() && isAgent() && getTenantId() == tenantId && resource.data.agentId == request.auth.uid);
        allow write: if canManage(tenantId);
      }

      match /goals/{goalId} {
        // Managers: full read/write. Agents: read their own goal doc (goalId == their uid).
        allow read:  if canManage(tenantId) ||
          (isSignedIn() && isAgent() && getTenantId() == tenantId && goalId == request.auth.uid);
        allow write: if canManage(tenantId);
      }

      match /notifications/{notificationId} {
        allow read:  if isSignedIn() && (isSuperAdminUID() || request.auth.uid == resource.data.userId);
        allow write: if canManage(tenantId);
      }

      match /leaderboard/{userId} {
        allow read:  if isSignedIn();
        allow write: if canManage(tenantId);
      }

      match /config/{docId} {
        allow read:  if isSignedIn() && getTenantId() == tenantId;
        allow write: if isSignedIn() && (isSuperAdminUID() || getRole() == 'super_admin');
      }

      match /settlements/{docId} {
        allow read: if isSignedIn() && (isSuperAdminUID() || getTenantId() == tenantId);
        allow write: if isSuperAdminUID()
          || request.auth.token.role == 'branch_manager'
          || get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.canConfirmSettlements == true;
        allow delete: if isSuperAdminUID()
          || request.auth.token.role == 'branch_manager'
          || get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.canConfirmSettlements == true;
      }

      match /unitGoals/{docId} {
        allow read: if request.auth != null
          && request.auth.token.tenantId == tenantId;

        allow write: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role == 'super_admin'
            || request.auth.token.role == 'branch_manager'
            || (
              request.auth.token.role == 'unit_manager'
              && docId.matches(request.auth.token.unitId + '_.*')
            )
          );
      }

      match /branchGoals/{docId} {
        allow read: if request.auth != null
          && request.auth.token.tenantId == tenantId;

        allow write: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role == 'super_admin'
            || request.auth.token.role == 'branch_manager'
          );
      }

      match /campaigns/{campaignId} {
        allow read: if request.auth != null
          && request.auth.token.tenantId == tenantId;

        allow create: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role == 'super_admin'
            || request.auth.token.role == 'branch_manager'
            || (
              request.auth.token.role == 'unit_manager'
              && request.resource.data.scope.type == 'unit'
            )
          );

        allow update, delete: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role == 'super_admin'
            || request.auth.token.role == 'branch_manager'
            || resource.data.createdBy == request.auth.uid
          );
      }

    }
  }
}
