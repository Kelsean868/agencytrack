rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return request.auth.token.get('role', '');
    }

    function getTenantId() {
      return request.auth.token.get('tenantId', '');
    }

    function isManager() {
      return getRole() in ['unit_manager', 'branch_manager', 'sales_manager', 'tenant_admin', 'platform_admin'];
    }

    function isAgent() {
      return getRole() == 'agent';
    }

    // Producing managers (UM + BM) file personal policies alongside their management role.
    // Used to extend the policies write arms to self-owned policy entries only.
    function isProducingManager() {
      return getRole() == 'unit_manager' || getRole() == 'branch_manager';
    }

    // Manager-role rank for upline/downline comparisons.
    // Hoisted from block-local *RoleRank copies (cn/jc/war x2) — all were byte-identical.
    function roleRank() {
      return getRole() == 'unit_manager'   ? 1 :
             getRole() == 'branch_manager' ? 2 :
             getRole() == 'sales_manager'  ? 3 :
             getRole() == 'tenant_admin'   ? 4 :
             getRole() == 'platform_admin' ? 5 : 0;
    }

    function canManage(tenantId) {
      return isSignedIn() && (getRole() in ['platform_admin', 'tenant_admin'] || (isManager() && getTenantId() == tenantId));
    }

    // Linked call sources (slice A). DELIBERATELY NARROWER than canManage():
    // canManage() routes through isManager(), which includes unit_manager, and a
    // unit manager must not mint a token that writes another agent's KPIs (a UM
    // cannot even see agentNumber in EditUserDrawer). This mirrors the Cloud
    // Functions' MANAGER_ROLES set exactly. Do NOT widen this, and do NOT
    // replace it with canManage() — that substitution fails silently.
    function canManageCallSources(tenantId) {
      return isSignedIn()
        && (getRole() in ['platform_admin', 'tenant_admin']
            || (getRole() in ['branch_manager', 'sales_manager'] && getTenantId() == tenantId));
    }

    function canAccessOwn(tenantId, agentId) {
      return isSignedIn() && (getRole() in ['platform_admin', 'tenant_admin'] || ((isAgent() || isProducingManager()) && getTenantId() == tenantId && request.auth.uid == agentId));
    }

    // E5: kiosk display session — read-only, tenant-scoped
    function isKiosk() {
      return getRole() == 'kiosk';
    }

    // FU SEC-012: kiosk reads are branch-scoped at each call site by pairing
    // kioskCanRead(tenantId) with an INLINE branch check
    // (branch == request.auth.token.branchId), mirroring the BM branch arms.
    // Inlined (not a helper taking resource.data.branchId) so the leading
    // kioskCanRead() short-circuits `&&` to false for non-kiosk callers before
    // any resource.data.branchId deref — no eager-eval error on branchless docs.
    // The kiosk token's branchId claim is minted by validateKioskToken.
    function kioskCanRead(tenantId) {
      return isSignedIn() && isKiosk() && getTenantId() == tenantId;
    }

    // SEC-4: fetch caller's unitId from Firestore profile (not token — unitId is not a custom claim)
    function callerUnitId(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.unitId;
    }

    // Analogous to callerUnitId — reads caller's branchId for BM branch-scoped rules.
    function callerBranchId(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.branchId;
    }

    // H1.2: legal agent transition guard — mirrors src/constants/policyLifecycle.js.
    // Lapsed is explicitly denied (H2). Terminal states (ntu/denied/settled) have no
    // outbound entries, so the OR chain naturally returns false for them.
    function isLegalAgentTransition(fromStatus, toStatus) {
      return toStatus != 'lapsed'
        && (
          (fromStatus == 'submitted' && toStatus in ['rated', 'postponed', 'ntu', 'denied', 'settled'])
          || (fromStatus == 'rated'     && toStatus in ['settled', 'ntu'])
          || (fromStatus == 'postponed' && toStatus in ['submitted', 'settled', 'denied'])
        );
    }

    // PR-3 (role refactor): cross-tenant audit log of admin account creations.
    // Top-level flat collection. Cloud Function writes via Admin SDK (rules
    // don't apply); clients can never write.
    // Renamed from auditSuperAdminCreations (PR-1/PR-2) to auditAdminCreations (PR-3).
    match /auditAdminCreations/{docId} {
      allow read: if isSignedIn() && (
        getRole() == 'platform_admin' ||
        (getRole() == 'tenant_admin' && resource.data.tenantId == getTenantId())
      );
      allow write: if false;
    }

    // Resend invite audit log — written exclusively by the resendInviteEmail
    // Cloud Function via Admin SDK (rules bypass). Clients never write.
    // Reads: platform_admin unrestricted; tenant_admin / branch_manager /
    // sales_manager scoped to own tenant (matches CF actor set in
    // RESEND_INVITE_ACTOR_ROLES). Mirrors auditAdminCreations rule shape.
    match /auditInviteResends/{docId} {
      allow read: if isSignedIn() && (
        getRole() == 'platform_admin' ||
        (getRole() in ['tenant_admin', 'branch_manager', 'sales_manager'] && resource.data.tenantId == getTenantId())
      );
      allow write: if false;
    }

    // feat(profile): audit log for tenant_admin self-service email changes.
    // Clients create their own entry (scoped by uid + tenantId); no edits or
    // deletes permitted. Mirrors auditAdminCreations read access pattern.
    match /auditAdminEmailUpdates/{docId} {
      allow read: if isSignedIn() && (
        getRole() == 'platform_admin' ||
        (getRole() == 'tenant_admin' && resource.data.tenantId == getTenantId())
      );
      allow create: if isSignedIn()
        && getRole() == 'tenant_admin'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tenantId == getTenantId()
        && request.resource.data.initiatedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // PR-D: mail/ queue for Firebase Trigger Email Extension.
    // All writes come from Cloud Functions via Admin SDK (bypasses rules).
    // No client read or write access — the extension handles delivery.
    match /mail/{docId} {
      allow read, write: if false;
    }

    match /tenants/{tenantId} {

      // PR-1 (user-management): tenant metadata (e.g., enumerated branchIds list
      // for UI dropdowns). Migration script writes via Admin SDK; clients read-only.
      match /meta/{docId} {
        allow read: if isSignedIn() && getTenantId() == tenantId;
        allow write: if false;
      }

      match /users/{userId} {
        // SHAKEDOWN-002: split read into get + list so unit_manager is restricted
        // to their own unit. BM/TA/PA retain full branch/tenant visibility.
        //
        // get: agents/kiosk read own doc; managers read any doc except unit_manager
        //      who can only read own doc or docs in their unit.
        allow get: if (kioskCanRead(tenantId) && resource != null && resource.data.branchId == request.auth.token.branchId)
          || (isSignedIn() && request.auth.uid == userId)
          || (canManage(tenantId) && (
               getRole() != 'unit_manager'
               || request.auth.uid == userId
               || resource.data.unitId == request.auth.uid
             ));
        // list: manager-tier only. unit_manager restricted to own unit;
        // branch_manager restricted to own branch. Defense in depth — clients
        // must include the corresponding where() clause for their role.
        allow list: if canManage(tenantId) && (
          (getRole() != 'unit_manager' && getRole() != 'branch_manager')
          || (getRole() == 'branch_manager' && callerBranchId(tenantId) != null && resource.data.branchId == callerBranchId(tenantId))
          || resource.data.unitId == request.auth.uid
        );
        // SEC-4: unit_manager can only create/update users within their own unit
        allow create: if canManage(tenantId) && (
          getRole() != 'unit_manager' ||
          callerUnitId(tenantId) == request.resource.data.unitId
        );
        // PR-4: manager-edit path enforces a field allowlist. Closes a pre-existing
        // privilege-laundering vector where any tenant manager could write claim-keyed
        // fields (role, branchId, ownedBranchIds) or audit-immutable fields
        // (createdAt, createdBy, tenantId, email) via direct Firestore updateDoc(),
        // creating divergence between the Firestore role/branchId and the custom
        // claim. Allowlist matches the v1 EditUserDrawer field set.
        //
        // Excluded from this path (must go through Admin SDK / Cloud Functions):
        //   - role, branchId, ownedBranchIds  → custom-claim divergence (PR-4b CF)
        //   - active                          → deactivateUser CF (token revocation)
        //   - email                           → auth-keyed
        //   - uid, tenantId                   → identity / tenant isolation
        //   - createdAt, createdBy, provisioning, csvImportBatchId, importedFromCsv
        //                                     → audit immutability
        allow update: if (canManage(tenantId)
            && (getRole() != 'unit_manager' || callerUnitId(tenantId) == resource.data.unitId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'name', 'phone', 'bio',
                  'unitId', 'unitName',
                  'agentNumber', 'contractStartDate', 'dateOfBirth',
                  // onboarding tenure — self-entered; manager corrects here (contractStartDate already in list above)
                  'monthsAtTatil', 'monthsInIndustry',
                  'canConfirmSettlements',
                  // manager-editable license fields; no CF/claim mirror
                  'licenseStatus', 'cbttExamPassedDate', 'cbttExtensionGranted', 'licenseProfile',
                  'updatedAt', 'updatedBy', 'onboardingComplete'
                ])
          ) || (isSignedIn()
            && request.auth.uid == userId
            && (
              (request.auth.token.role == 'unit_manager'
               && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['unitName', 'hasSeenWelcome', 'photoURL', 'bio', 'phone',
                            'loggingMode', 'dailyNudgeTime', 'updatedAt']))
              ||
              request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['hasSeenWelcome', 'photoURL', 'bio', 'phone',
                           'loggingMode', 'dailyNudgeTime', 'updatedAt', 'email',
                           'licenseProfile'])
            ))
          // appearOnLeaderboard: BM self opt-in only. UM/SM/TA/agent cannot set.
          || (isSignedIn()
              && request.auth.uid == userId
              && getRole() == 'branch_manager'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['appearOnLeaderboard'])
          )
          // Onboarding write-once: owner sets agentNumber / dateOfBirth / contractStartDate /
          // monthsAtTatil / monthsInIndustry (write-once; pilot relaxation — manager corrects
          // via canManage arm) and onboardingComplete.
          // Whitelist prevents role / tenantId laundering in the same update.
          || (isSignedIn()
              && request.auth.uid == userId
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['agentNumber', 'dateOfBirth', 'onboardingComplete',
                             'contractStartDate', 'monthsAtTatil', 'monthsInIndustry'])
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['agentNumber'])
                  || (resource.data.get('agentNumber', null) == null
                      && request.resource.data.agentNumber is string
                      && request.resource.data.agentNumber != ''))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dateOfBirth'])
                  || (resource.data.get('dateOfBirth', null) == null
                      && request.resource.data.dateOfBirth is string
                      && request.resource.data.dateOfBirth != ''))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['onboardingComplete'])
                  || request.resource.data.onboardingComplete is bool)
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['contractStartDate'])
                  || (resource.data.get('contractStartDate', '') == ''
                      && request.resource.data.contractStartDate is string
                      && request.resource.data.contractStartDate != ''))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['monthsAtTatil'])
                  || (resource.data.get('monthsAtTatil', null) == null
                      && request.resource.data.monthsAtTatil is int
                      && request.resource.data.monthsAtTatil >= 0))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['monthsInIndustry'])
                  || (resource.data.get('monthsInIndustry', null) == null
                      && request.resource.data.monthsInIndustry is int
                      && request.resource.data.monthsInIndustry >= 0))
          );
        allow delete: if canManage(tenantId) && getRole() != 'unit_manager';
      }

      // E6: per-agent daily entries. Agent-private — managers continue to
      // see weekly submissions only. Aggregator (Cloud Function) reads via
      // Admin SDK and bypasses rules.
      match /users/{userId}/dailyActivity/{date} {
        allow read, write: if isSignedIn()
          && getTenantId() == tenantId
          && request.auth.uid == userId;
      }

      match /submissions/{submissionId} {
        // unitId is denormalized onto every submission doc at write time.
        //
        // get: resource.data.unitId is available — UM restricted to own-unit
        //      submissions via direct field check (no cross-doc lookup needed).
        // list: resource.data.unitId is available for query evaluation — UM list
        //       queries must include where('unitId','==',callerUid); rule enforces
        //       this, closing the partial defense-in-depth gap from SHAKEDOWN-002B.
        //       BM/TA/PA retain full visibility.
        // Slice 2 (submission-branchid): BM arm restricted to own-branch docs.
        // TA/SM/PA: unrestricted (canManage + not BM/UM).
        // UM: own-unit only (resource.data.unitId == uid).
        // BM: own-branch only (resource.data.branchId == token.branchId).
        // For `allow list`, Firestore evaluates the rule against each potential
        // result doc — a BM query without where('branchId','==',claim) cannot
        // guarantee every result satisfies the rule → Firestore DENIES the query.
        // This closes the crafted-query bypass (the point of denormalization).
        // Non-existent-doc owner arm (MUST precede any resource.data deref):
        // a get on a missing doc evaluates with resource == null, so the
        // canAccessOwn(resource.data.agentId) arm below errors → deny. The wizard's
        // getDraft (and aggregateCurrentWeekDaily's pre-write getDoc) read
        // submissions/{uid}_{weekStarting} for a not-yet-started week → the doc is
        // absent → permission-denied, which breaks client-side daily→weekly
        // aggregation (draft only built by the Sunday cron). docId is
        // `${uid}_${weekStarting}` (uid alphanumeric, weekStarting YYYY-MM-DD —
        // both underscore-free), so the id prefix IS the owner uid. Scoping to the
        // owner (not bare `resource == null`) blocks the cross-user existence
        // oracle; `getTenantId() == tenantId` preserves tenant isolation (mirrors
        // canAccessOwn) so a cross-tenant agent can't probe this tenant's paths.
        // `||` short-circuits before the deref when this arm is true.
        allow get: if (kioskCanRead(tenantId) && resource != null && resource.data.branchId == request.auth.token.branchId)
          || (resource == null && isSignedIn() && getTenantId() == tenantId && submissionId.split('_')[0] == request.auth.uid)
          || canAccessOwn(tenantId, resource.data.agentId)
          || (canManage(tenantId) && (
               (getRole() != 'unit_manager' && getRole() != 'branch_manager')
               || (getRole() == 'unit_manager' && resource.data.unitId == request.auth.uid)
               || (getRole() == 'branch_manager' && resource.data.branchId == request.auth.token.branchId)
             ));
        // list: canAccessOwn restored after the SHAKEDOWN-002B read->get/list split
        //       dropped it. resource.data.agentId IS evaluable in list evaluation, so
        //       an agent self-list query — which MUST be constrained
        //       where('agentId','==',uid) — is allowed; any broader/unconstrained agent
        //       query is denied because the other clauses are false for an agent caller.
        //       UM unit-scope clause and BM branch-scope clause mirror the get rule.
        allow list: if (kioskCanRead(tenantId) && resource.data.branchId == request.auth.token.branchId)
          || canAccessOwn(tenantId, resource.data.agentId)
          || (canManage(tenantId) && (
               (getRole() != 'unit_manager' && getRole() != 'branch_manager')
               || (getRole() == 'unit_manager' && resource.data.unitId == request.auth.uid)
               || (getRole() == 'branch_manager' && resource.data.branchId == request.auth.token.branchId)
             ));
        allow create: if canManage(tenantId)
          || (canAccessOwn(tenantId, request.resource.data.agentId)
              && request.resource.data.branchId == request.auth.token.branchId);
        allow update: if canManage(tenantId)
          || (canAccessOwn(tenantId, resource.data.agentId)
              && resource.data.status == 'draft'
              && request.resource.data.branchId == request.auth.token.branchId);
        allow delete: if false;
      }

      // H1: policy ledger — walking skeleton (new collection, no lifecycle).
      // Agent creates + owns entries; managers-in-scope read.
      // unitId + branchId denormalized for UM/BM query filtering (mirrors submissions).
      // Manager two-arm confirmation update is DEFERRED to H1.2.
      match /policies/{policyId} {
        // Tier-3 3.1: cro (back-office) reads policies tenant-wide — the
        // Delivery Register is a query surface over this collection.
        function isCroInTenant() {
          return getRole() == 'cro' && getTenantId() == tenantId;
        }

        allow get: if canAccessOwn(tenantId, resource.data.agentId)
          || (canManage(tenantId) && (
               getRole() != 'unit_manager'
               || resource.data.unitId == request.auth.uid
             ))
          || isCroInTenant();
        allow list: if canAccessOwn(tenantId, resource.data.agentId)
          || (canManage(tenantId) && (
               getRole() != 'unit_manager'
               || resource.data.unitId == request.auth.uid
             ))
          || isCroInTenant();
        allow create: if isSignedIn()
          && (isAgent() || isProducingManager())
          && getTenantId() == tenantId
          && request.resource.data.agentId == request.auth.uid
          && request.resource.data.tenantId == tenantId
          && request.resource.data.status == 'submitted'
          && request.resource.data.sourceOfProspect in [
               'seminar', 'booth-event', 'referral', 'cold-call', 'social-media',
               'orphan', 'existing-client', 'family-friend', 'bank-referral', 'self', 'other'
             ]
          && request.resource.data.dateWritten <= request.time
          && request.resource.data.proposedAPI > 0;
        // Arm A — body-edit (own submitted-status policy, hardened per FU Entry 2).
        // Status must remain 'submitted'; only body fields may change.
        // Value-guards: sourceOfProspect in enum, dateWritten not future, proposedAPI > 0.
        allow update: if isSignedIn()
          && (isAgent() || isProducingManager())
          && getTenantId() == tenantId
          && resource.data.agentId == request.auth.uid
          && resource.data.status == 'submitted'
          && request.resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'ownerName', 'insuredName', 'policyNumber', 'productLine',
               'newBusinessType', 'policyClass', 'planId', 'planName',
               'proposedPremium', 'proposedFrequency', 'proposedAPI',
               'proposedCoverage', 'dateWritten', 'dateSubmitted', 'notes',
               'isSelfOrFamily', 'replacedPolicyAPI',
               'sourceOfProspect', 'socialPlatform', 'cashWithApp'
             ])
          && request.resource.data.sourceOfProspect in [
               'seminar', 'booth-event', 'referral', 'cold-call', 'social-media',
               'orphan', 'existing-client', 'family-friend', 'bank-referral', 'self', 'other'
             ]
          && request.resource.data.dateWritten <= request.time
          && request.resource.data.proposedAPI > 0;

        // Arm B — legal status transition (agent-owned subset of PRD §7).
        // OR'd with Arm A by Firestore. Per-target field sets (H2a loosening #1
        // closed): each target status only allows status + statusUpdatedAt + that
        // status's own fields. Value-guards enforce required fields.
        allow update: if isSignedIn()
          && (isAgent() || isProducingManager())
          && getTenantId() == tenantId
          && resource.data.agentId == request.auth.uid
          && isLegalAgentTransition(resource.data.status, request.resource.data.status)
          && (
            // submitted (re-entry from postponed): no extra fields
            (request.resource.data.status == 'submitted'
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'statusUpdatedAt']))
            || (request.resource.data.status == 'rated'
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'statusUpdatedAt', 'ratedPremium', 'rateReason'])
                && request.resource.data.ratedPremium is number
                && request.resource.data.ratedPremium > 0)
            || (request.resource.data.status == 'postponed'
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'statusUpdatedAt', 'pendingReason']))
            || (request.resource.data.status in ['ntu', 'denied']
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'statusUpdatedAt', 'reason']))
            || (request.resource.data.status == 'settled'
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'statusUpdatedAt',
                               'dateIssued', 'settledAPI', 'issuedCoverage',
                               'initialPremium', 'earnedCommission'])
                && request.resource.data.dateIssued is timestamp
                && request.resource.data.dateIssued >= resource.data.dateWritten
                && request.resource.data.dateIssued <= request.time
                && request.resource.data.settledAPI is number
                && request.resource.data.settledAPI > 0
                && request.resource.data.issuedCoverage is number
                && request.resource.data.issuedCoverage > 0
                && request.resource.data.initialPremium is number
                && request.resource.data.initialPremium > 0
                && request.resource.data.earnedCommission is number
                && request.resource.data.earnedCommission >= 0)
          );

        // Arm C — manager confirmation (H2a). OR'd with Arms A + B by Firestore.
        // Writes the 6 confirmation fields only; never status or any agent field.
        // Gate mirrors the settlements write gate + the existing UM unit-scoping.
        allow update: if isSignedIn()
          && canManage(tenantId)
          && (getRole() in ['platform_admin', 'tenant_admin']
              || getRole() == 'branch_manager'
              || get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.canConfirmSettlements == true)
          && (getRole() != 'unit_manager' || resource.data.unitId == request.auth.uid)
          && resource.data.status == 'settled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'confirmedByManager', 'confirmedByUid', 'confirmedAt',
               'managerSettledAPI', 'managerNote', 'hasDiscrepancy'
             ])
          && request.resource.data.confirmedByUid == request.auth.uid
          && request.resource.data.managerSettledAPI is number
          && request.resource.data.managerSettledAPI > 0
          && request.resource.data.hasDiscrepancy is bool;

        // Arm E — CRO delivery confirmation (Tier-3 3.1, back-office role).
        // The cro role marks a SETTLED policy delivered — touching ONLY the
        // three delivery fields. `policyDeliveryDate` is the H1-deferred
        // milestone field already stamped null at create (policiesService.js);
        // deliveredBy pinned to auth.uid; delivery may be backdated (recorded
        // after the fact) but never future. The 30-day clawback clock is
        // DISPLAY-ONLY (derived from dateIssued), never stored. OR'd with the
        // other arms by Firestore.
        allow update: if isSignedIn()
          && isCroInTenant()
          && resource.data.status == 'settled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['policyDeliveryDate', 'deliveredBy', 'deliveredAt'])
          && request.resource.data.policyDeliveryDate is timestamp
          && request.resource.data.policyDeliveryDate <= request.time
          && request.resource.data.deliveredBy == request.auth.uid
          && request.resource.data.deliveredAt is timestamp;

        // Arm D — BM-only settled→lapsed (H2c). Explicitly excludes UM and
        // canConfirmSettlements-only callers; only branch_manager / tenant_admin /
        // platform_admin may lapse a policy. OR'd with Arms A/B/C.
        allow update: if isSignedIn()
          && canManage(tenantId)
          && getRole() in ['platform_admin', 'tenant_admin', 'branch_manager']
          && resource.data.status == 'settled'
          && request.resource.data.status == 'lapsed'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'statusUpdatedAt', 'dateLapsed', 'lapseReason'])
          && request.resource.data.dateLapsed is timestamp;

        allow delete: if false;

        // H1.2: policy history subcollection — append-only audit (PRD §7.4).
        // Written only via writeBatch alongside status transitions or confirmation;
        // update/delete are permanently closed.
        match /history/{historyId} {
          allow get: if canAccessOwn(tenantId, resource.data.agentId)
            || (canManage(tenantId) && (
                 getRole() != 'unit_manager'
                 || resource.data.unitId == request.auth.uid
               ));
          allow list: if canAccessOwn(tenantId, resource.data.agentId)
            || (canManage(tenantId) && (
                 getRole() != 'unit_manager'
                 || resource.data.unitId == request.auth.uid
               ));

          // Agent arm: agent writes their own policy's history (H2a loosening #2
          // closed — parent-policy agentId must match the caller, preventing an
          // agent from writing orphan history docs under another agent's policy).
          allow create: if isSignedIn()
            && (isAgent() || isProducingManager())
            && getTenantId() == tenantId
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.agentId == request.auth.uid
            && get(/databases/$(database)/documents/tenants/$(tenantId)/policies/$(policyId)).data.agentId == request.auth.uid
            && request.resource.data.keys().hasAll([
                 'fromStatus', 'toStatus', 'changedFields', 'actorUid',
                 'actorRole', 'at', 'agentId'
               ])
            && isLegalAgentTransition(
                 request.resource.data.fromStatus,
                 request.resource.data.toStatus
               );

          // Manager arm: manager writes a confirmation event (H2a).
          // fromStatus == toStatus == 'settled' is explicitly allowed (confirm
          // is a field-change event, not a lifecycle transition).
          // In-scope check mirrors Arm C: UM restricted to own unit via parent policy;
          // BM/admin tenant-scoped via canManage.
          allow create: if canManage(tenantId)
            && (getRole() in ['platform_admin', 'tenant_admin']
                || getRole() == 'branch_manager'
                || get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.canConfirmSettlements == true)
            && (getRole() != 'unit_manager'
                || get(/databases/$(database)/documents/tenants/$(tenantId)/policies/$(policyId)).data.unitId == request.auth.uid)
            && request.resource.data.actorUid == request.auth.uid
            // H2b: agentId in history doc must match the parent policy's agentId
            // (prevents managers from writing history docs with a forged agentId).
            && request.resource.data.agentId == get(
                 /databases/$(database)/documents/tenants/$(tenantId)/policies/$(policyId)
               ).data.agentId
            && request.resource.data.keys().hasAll([
                 'fromStatus', 'toStatus', 'changedFields', 'actorUid',
                 'actorRole', 'at', 'agentId', 'unitId'
               ]);

          allow update: if false;
          allow delete: if false;
        }
      }

      // E3: persistency — role-scoped by agent's branchId/unitId. Replaces the
      // pre-E3 manager-can-write-anywhere block. Agents can write their own
      // doc (manager wins on collision via app-layer audit-trail precedence).
      // Non-negative validation on the six business inputs is enforced here
      // so the data layer cannot store negative TTD figures.
      match /persistency/{docId} {
        function existingAgentBranchId() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(resource.data.agentId)).data.branchId;
        }
        function existingAgentUnitId() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(resource.data.agentId)).data.unitId;
        }
        function newDocAgentBranchId() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.resource.data.agentId)).data.branchId;
        }
        function callerBranchId() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.branchId;
        }
        function validE3InputsNonNegative() {
          return request.resource.data.businessPlaced  >= 0
              && request.resource.data.notTakens       >= 0
              && request.resource.data.incPPPs         >= 0
              && request.resource.data.lumpsums100     >= 0
              && request.resource.data.lapses          >= 0
              && request.resource.data.reinstatements  >= 0
              && request.resource.data.tenantId == tenantId
              && request.resource.data.lastEditedByRole == getRole()
              && request.resource.data.lastEditedBy == request.auth.uid;
        }

        // allow list is intentionally permissive within tenant scope.
        // Firestore cannot evaluate resource.data for list operations, so
        // per-doc rules (allow get below) handle strict access. Clients
        // must apply where() filters; isE3Doc() in persistencyService.js
        // strips legacy docs before UI render.
        // Trade-off + follow-ups: see SCOPE-2 and PERF-1 in docs/FOLLOW_UPS.md
        // (to be added in a separate post-pilot housekeeping PR).
        allow list: if isSignedIn() && getTenantId() == tenantId;

        allow get: if isSignedIn() && getTenantId() == tenantId && (
          getRole() in ['platform_admin', 'tenant_admin', 'sales_manager']
          // Allow reads of non-existent docs so pre-write getDoc() in savePersistency
          // returns cleanly (doc.exists() === false). No data leakage — resource is null.
          || resource == null
          || (isAgent() && resource.data.agentId == request.auth.uid)
          || (getRole() == 'branch_manager' && existingAgentBranchId() == callerBranchId())
          || (getRole() == 'unit_manager'   && existingAgentUnitId()   == callerUnitId(tenantId))
        );

        allow create, update: if isSignedIn() && getTenantId() == tenantId
          && validE3InputsNonNegative()
          && (
            getRole() in ['platform_admin', 'tenant_admin']
            || (isAgent() && request.resource.data.agentId == request.auth.uid)
            || (getRole() == 'branch_manager' && newDocAgentBranchId() == callerBranchId())
          );

        allow delete: if false;
      }

      match /goals/{goalId} {
        allow read:  if canManage(tenantId) ||
          (isSignedIn() && (isAgent() || isProducingManager()) && getTenantId() == tenantId && goalId == request.auth.uid);
        // goalId == agentId (UID) always — service writes `goals/{agentId}`.
        // Agents write their own commitment; managers write target fields.
        // SEC-4 pattern: unit_manager scoped to own-unit agents only
        // (cross-doc unitId lookup, same as users write gate).
        // branch_manager, sales_manager, tenant_admin, platform_admin: unrestricted.
        allow write: if
          (isSignedIn() && (isAgent() || isProducingManager()) && getTenantId() == tenantId && goalId == request.auth.uid)
          || (canManage(tenantId) && (
            getRole() != 'unit_manager'
            || (callerUnitId(tenantId) != null
                && callerUnitId(tenantId) == get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(goalId)).data.unitId)
          ));
      }

      match /notifications/{notificationId} {
        // SEC-3: add tenant scope to notification reads
        allow read:  if isSignedIn() && getTenantId() == tenantId && (getRole() in ['platform_admin', 'tenant_admin'] || request.auth.uid == resource.data.userId);
        // SEC-10: recipient can mark their own notification read; field-restricted to read/readAt
        allow update: if (isSignedIn() && getTenantId() == tenantId
                         && request.auth.uid == resource.data.userId
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']))
                      || canManage(tenantId);
        allow create, delete: if canManage(tenantId);
      }

      match /leaderboard/{userId} {
        // SEC-2: scope leaderboard reads to own tenant
        allow read:  if isSignedIn() && getTenantId() == tenantId;
        allow write: if canManage(tenantId);
      }

      match /config/{docId} {
        allow read:  if isSignedIn() && getTenantId() == tenantId;

        // Run 5 Item 5 — featureFlags allowlist. On config/settings, any change to
        // the featureFlags / featureFlagsMeta maps may only add, modify, or remove
        // the allowlisted keys. Server-side mirror of ALLOWED_FLAG_KEYS
        // (src/services/configService.js) and ALLOWED_FLAGS
        // (scripts/verification/vh/flag-toggle.cjs) — a deliberate triple-copy;
        // src/services/__tests__/flagAllowlist.cross-check.test.js guards the drift.
        // request.resource.data is the POST-MERGE doc, so unchanged pre-existing
        // keys never appear in the diff — only keys this write adds, modifies, or
        // removes are evaluated. On doc-create resource == null (old maps → {}).
        function ccfgFlagKeysAllowed() {
          let allowed = ['persistencyV2', 'policyLedgerCampaignLens', 'awardsProvenance'];
          let oldFlags = resource == null ? {} : resource.data.get('featureFlags', {});
          let newFlags = request.resource.data.get('featureFlags', {});
          let oldMeta  = resource == null ? {} : resource.data.get('featureFlagsMeta', {});
          let newMeta  = request.resource.data.get('featureFlagsMeta', {});
          return newFlags.diff(oldFlags).affectedKeys().hasOnly(allowed)
              && newMeta.diff(oldMeta).affectedKeys().hasOnly(allowed);
        }

        // SEC: tenant-scope guard. platform_admin is cross-tenant by design;
        // tenant_admin must be writing into their own tenant's config.
        // create/update additionally enforce the featureFlags allowlist on
        // config/settings; delete keeps the original role/tenant check unchanged.
        allow create, update: if isSignedIn()
          && getRole() in ['platform_admin', 'tenant_admin']
          && (getRole() == 'platform_admin' || getTenantId() == tenantId)
          && (docId != 'settings' || ccfgFlagKeysAllowed());
        allow delete: if isSignedIn()
          && getRole() in ['platform_admin', 'tenant_admin']
          && (getRole() == 'platform_admin' || getTenantId() == tenantId);
      }

      // Run 5 Item 3 — append-only tenant config audit trail. One entry per changed
      // setting, written in the SAME batch as the config mutation
      // (src/services/configAuditService.js buildAuditEntry). Entries are immutable:
      // no update, no delete. `at` is a serverTimestamp() the rules engine sees as
      // request.time; `who` must be the authenticated writer. `from`/`to` are
      // display strings that MAY be null (first-set / envelope saves write from: null;
      // toDisplay() returns null for null/undefined values). `correction` is an
      // optional slice-2 reason string.
      match /configAudit/{entryId} {
        allow read: if isSignedIn()
          && getRole() in ['platform_admin', 'tenant_admin']
          && (getRole() == 'platform_admin' || getTenantId() == tenantId);
        allow create: if isSignedIn()
          && getRole() in ['platform_admin', 'tenant_admin']
          && (getRole() == 'platform_admin' || getTenantId() == tenantId)
          && request.resource.data.keys().hasAll(['settingId', 'section', 'from', 'to', 'who', 'whoName', 'at'])
          && request.resource.data.keys().hasOnly(['settingId', 'section', 'from', 'to', 'who', 'whoName', 'at', 'correction'])
          && request.resource.data.settingId is string
          && request.resource.data.section is string
          && (request.resource.data.from is string || request.resource.data.from == null)
          && (request.resource.data.to is string || request.resource.data.to == null)
          && request.resource.data.who == request.auth.uid
          && request.resource.data.whoName is string
          && request.resource.data.at == request.time
          && (!('correction' in request.resource.data) || request.resource.data.correction is string);
        allow update, delete: if false;
      }

      match /settlements/{docId} {
        // Tightened read (settlements-read-scope, 2026-06-05):
        //   agents — own only (resource.data.agentId == uid via canAccessOwn).
        //   managers — tenant-scoped via canManage (all tiers).
        // NOTE: settlement docs carry no unitId/branchId field. The D1 brief target
        // of UM-same-unit / BM-same-branch granular scoping cannot be enforced at
        // the rules layer without schema denorm or a 2-read cross-doc lookup.
        // Simplified tightening is presented to dispatcher at Phase 1 STOP — the
        // primary security fix (agent reads peer's settlements) is closed by the
        // canAccessOwn arm regardless.
        allow get:  if canAccessOwn(tenantId, resource.data.agentId) || canManage(tenantId);
        allow list: if canAccessOwn(tenantId, resource.data.agentId) || canManage(tenantId);
        allow write: if isSignedIn() && (getRole() in ['platform_admin', 'tenant_admin']
          || getRole() == 'branch_manager'
          || get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.canConfirmSettlements == true);
        allow delete: if isSignedIn() && (getRole() in ['platform_admin', 'tenant_admin']
          || getRole() == 'branch_manager'
          || get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.canConfirmSettlements == true);
      }

      // ── Track K · K1 — per-agent financing terms ─────────────────────────────
      // /tenants/{tid}/financingTerms/{agentId}  (doc ID == agent UID; one
      // current-terms doc per agent). Manager-set; gates all later financing
      // modules (K2–K8). Read mirrors settlements (agent reads own via
      // canAccessOwn keyed on the {agentId} path var; managers via canManage —
      // unit_manager reads, but cannot write). Write is BM-and-up (unit_manager
      // EXCLUDED per contract 5.3) — an explicit role set, deliberately NOT a
      // shared helper (canManage) that would admit unit_manager. Coarse
      // validation only (U2 single-boundary precedent): the cross-field rule
      // (currentMonthlyFinancing <= agreedMonthlyFinancing) and forward-only
      // transition legality live in financingService + UI, NOT here.
      // No `list` arm: K1 reads a single per-agent doc (getFinancingTerms →
      // getDoc); a collection-list feature (agent dashboard) would add one at K8.
      match /financingTerms/{agentId} {
        function validFinancingData() {
          return request.resource.data.agreedMonthlyFinancing  is number
              && request.resource.data.agreedMonthlyFinancing  >= 0
              && request.resource.data.currentMonthlyFinancing is number
              && request.resource.data.currentMonthlyFinancing >= 0
              && request.resource.data.validatingAPI           is number
              && request.resource.data.validatingAPI           >= 0
              && request.resource.data.financingStatus in [
                   'not_on_financing', 'on_financing', 'reconciling',
                   'post_financing_repayment', 'cleared'
                 ]
              && request.resource.data.effectiveDate is string
              && request.resource.data.agentId  == agentId
              && request.resource.data.tenantId == tenantId;
        }

        allow get: if canAccessOwn(tenantId, agentId) || canManage(tenantId);

        allow create, update: if validFinancingData() && (
          (getRole() in ['branch_manager', 'sales_manager', 'tenant_admin'] && getTenantId() == tenantId)
          || getRole() == 'platform_admin'
        );

        allow delete: if false;
      }

      // ── Track K · K2 — per-agent monthly financing ledger ────────────────────
      // /tenants/{tid}/financing/{agentId}_{YYYY_MM}  (composite doc ID; one doc
      // per agent-month). The agent's monthly statement, entered manually:
      // financingPaid / netCommission / bonusOffset / runningBalance + notes.
      // runningBalance is AUTHORITATIVE (stored from the statement, never derived)
      // and MAY be negative (= surplus owed back to the agent). Read mirrors
      // settlements (composite-ID doc with a stored `agentId` field — keyed on
      // resource.data.agentId, NOT a path var). Write is BM-and-up (unit_manager
      // EXCLUDED per contract 5.3), identical to the K1 financingTerms posture.
      // Coarse validation only (U2 single-boundary): month matches YYYY_MM,
      // agentId/tenantId present. The K2 STATEMENT core (runningBalance /
      // financingPaid / netCommission / bonusOffset) is required only when the
      // write carries any statement field — so a K5 PRORATION-only write (no
      // statement fields, forward of any statement) is permitted while a partial
      // statement still fails. The K5 proration fields are coarse type-checked
      // when present (numbers; basisSource in the 3-enum; adjustmentPct may be
      // negative). Still NO key-allowlist / no hasOnly — the permissive posture is
      // preserved (additional fields pass). basisSource IS written by K5. delete denied.
      match /financing/{docId} {
        function hasAnyStatementField() {
          return request.resource.data.keys().hasAny(['runningBalance', 'financingPaid', 'netCommission', 'bonusOffset']);
        }
        function validStatementCore() {
          return request.resource.data.runningBalance is number
              && request.resource.data.financingPaid  is number && request.resource.data.financingPaid  >= 0
              && request.resource.data.netCommission  is number && request.resource.data.netCommission  >= 0
              && request.resource.data.bonusOffset    is number && request.resource.data.bonusOffset    >= 0;
        }
        function validProrationFields() {
          return (!('validatingAPI'      in request.resource.data) || (request.resource.data.validatingAPI      is number && request.resource.data.validatingAPI      >= 0))
              && (!('actualAPI'          in request.resource.data) || (request.resource.data.actualAPI          is number && request.resource.data.actualAPI          >= 0))
              && (!('suggestedFinancing' in request.resource.data) || (request.resource.data.suggestedFinancing is number && request.resource.data.suggestedFinancing >= 0))
              && (!('managerFinancing'   in request.resource.data) || (request.resource.data.managerFinancing   is number && request.resource.data.managerFinancing   >= 0))
              && (!('adjustmentPct'      in request.resource.data) || request.resource.data.adjustmentPct       is number)
              && (!('basisSource'        in request.resource.data) || request.resource.data.basisSource in ['submitted-final', 'submitted-provisional', 'settled-confirmed']);
        }
        function validFinancingMonth() {
          return request.resource.data.agentId  is string
              && request.resource.data.tenantId == tenantId
              && request.resource.data.month    is string
              && request.resource.data.month.matches('^[0-9]{4}_[0-9]{2}$')
              && (!hasAnyStatementField() || validStatementCore())
              && validProrationFields();
        }

        allow get:  if canAccessOwn(tenantId, resource.data.agentId) || canManage(tenantId);
        allow list: if canAccessOwn(tenantId, resource.data.agentId) || canManage(tenantId);

        allow create, update: if validFinancingMonth() && (
          (getRole() in ['branch_manager', 'sales_manager', 'tenant_admin'] && getTenantId() == tenantId)
          || getRole() == 'platform_admin'
        );

        allow delete: if false;
      }

      // ── Track K · K6 — per-agent-year reconciliation record ───────────────────
      // /tenants/{tid}/financingReconciliation/{agentId}_{year}  (composite doc ID;
      // one record per agent-year). The year-1 wind-down event: total drawn vs
      // offsets, the service-gated first-3-months waiver, and the surplus/owing
      // outcome. Written by financingService.reconcileFinancing (the calc lives in
      // src/lib/financingReconciliation.js; status transitions ride K1's machine).
      // Mirrors the K2 ledger posture exactly: read keyed on the STORED agentId field
      // (composite ID, so the {agentId} path-var trick K1 uses does not apply — the
      // settlements/K2 read shape), write BM/SM/TA same-tenant + PA (unit_manager
      // EXCLUDED, contract 5.3). Coarse type/enum validation only (U2 single-boundary):
      // agentId string, tenantId == path tenant, outcome in the 2-enum, triggeredBy in
      // the 2-enum, the money fields are numbers (closingBalance / reconciledBalance MAY
      // be negative = surplus; waiverApplied / surplusPaid >= 0). No key-allowlist / no
      // hasOnly (permissive posture preserved). delete denied.
      match /financingReconciliation/{docId} {
        function validReconciliation() {
          return request.resource.data.agentId  is string
              && request.resource.data.tenantId == tenantId
              && request.resource.data.year        is int
              && request.resource.data.outcome     in ['owing', 'surplus']
              && request.resource.data.triggeredBy in ['auto_month12', 'manual_election']
              && request.resource.data.totalFinancingDrawn is number
              && request.resource.data.totalOffsets        is number
              && request.resource.data.closingBalance      is number
              && request.resource.data.reconciledPosition  is number
              && request.resource.data.waiverApplied is number && request.resource.data.waiverApplied >= 0
              && request.resource.data.surplusPaid   is number && request.resource.data.surplusPaid   >= 0
              && request.resource.data.serviceMonths is int    && request.resource.data.serviceMonths >= 0
              && request.resource.data.serviceMet    is bool
              && request.resource.data.garnishStarted is bool;
        }

        allow get:  if canAccessOwn(tenantId, resource.data.agentId) || canManage(tenantId);
        allow list: if canAccessOwn(tenantId, resource.data.agentId) || canManage(tenantId);

        allow create, update: if validReconciliation() && (
          (getRole() in ['branch_manager', 'sales_manager', 'tenant_admin'] && getTenantId() == tenantId)
          || getRole() == 'platform_admin'
        );

        allow delete: if false;
      }

      match /unitGoals/{docId} {
        allow read: if request.auth != null
          && request.auth.token.tenantId == tenantId;

        allow write: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role in ['platform_admin', 'tenant_admin']
            || request.auth.token.role == 'branch_manager'
            || request.auth.token.role == 'sales_manager' // BUG-N2: sales_manager has at least branch_manager-level scope per 5-tier hierarchy
            || (
              request.auth.token.role == 'unit_manager'
              // BUG-N fix: use callerUnitId() helper (SEC-4 pattern) — unitId is not a custom claim
              && docId.matches(callerUnitId(tenantId) + '_.*')
            )
          );
      }

      match /branchGoals/{docId} {
        allow read: if request.auth != null
          && request.auth.token.tenantId == tenantId;

        allow write: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role in ['platform_admin', 'tenant_admin']
            || request.auth.token.role == 'branch_manager'
          );
      }

      match /salesManagerGoals/{docId} {
        allow read: if request.auth != null
          && request.auth.token.tenantId == tenantId;

        allow write: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role in ['platform_admin', 'tenant_admin']
            || (request.auth.token.role == 'sales_manager'
                && docId.matches(request.auth.uid + '_.*'))
          );
      }

      match /campaigns/{campaignId} {
        allow read: if request.auth != null
          && request.auth.token.tenantId == tenantId;

        allow create: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role in ['platform_admin', 'tenant_admin']
            || request.auth.token.role == 'branch_manager'
            || (
              request.auth.token.role == 'unit_manager'
              && request.resource.data.scope.type == 'unit'
            )
          );

        allow update, delete: if request.auth != null
          && request.auth.token.tenantId == tenantId
          && (
            request.auth.token.role in ['platform_admin', 'tenant_admin']
            || request.auth.token.role == 'branch_manager'
            || resource.data.createdBy == request.auth.uid
          );
      }

      // Track C C1: branches as a real subcollection under each tenant.
      // tenant_admin / platform_admin CRUD; any signed-in user in the
      // tenant can read for dropdowns. Soft delete only (isActive flag).
      // Per-doc updatedBy + updatedAt audit trail; no separate audit
      // collection until P11. Mirrors the B5 config/{docId} tenant-scope
      // guard pattern.
      match /branches/{branchId} {
        allow read:  if isSignedIn() && getTenantId() == tenantId;
        allow write: if isSignedIn()
          && getRole() in ['platform_admin', 'tenant_admin']
          && (getRole() == 'platform_admin' || getTenantId() == tenantId);
      }

      // E5: kiosk tokens. Manager-tier roles manage tokens; Cloud Function
      // validateKioskToken reads via Admin SDK (bypasses rules entirely).
      match /kioskTokens/{tokenId} {
        allow read, write, delete: if canManage(tenantId);
      }

      // Linked call sources (slice A). An external calling system presents a
      // bearer token; the token resolves to one of these docs; the doc names the
      // agent whose KPIs move. Identity never travels in a request body.
      //
      // Read is gated on canManageCallSources — NOT canManage — so agents and
      // unit managers cannot read the collection at all. Two independent
      // defences protect the token: this gate, and the fact that only the
      // SHA-256 hash is ever stored (the raw token is returned once at creation
      // and never persisted), so even a rules mistake leaks nothing usable.
      //
      // Writes are Cloud-Function-only (Admin SDK bypasses rules). The client
      // never writes here: createCallSource mints and hashes, revokeCallSource
      // sets revokedAt, and deactivateUser revokes inbound links.
      match /callSources/{sourceId} {
        allow read:  if canManageCallSources(tenantId);
        allow write: if false;
      }

      // E6: Agent of the Month — manager UI + kiosk display read.
      // Cloud Function writes via Admin SDK (bypasses rules).
      match /agentOfMonth/{monthKey} {
        allow read: if canManage(tenantId)
          || (kioskCanRead(tenantId) && resource != null && resource.data.branchId == request.auth.token.branchId);
        allow write: if false;
      }

      // Track J P1b: leaderboard-aggregate doc per branch (precomputed by
      // recomputeLeaderboardScheduled / recomputeLeaderboardOnDemand CFs via
      // Admin SDK). Agents read their OWN branch only (SEC-4 doc-read pattern,
      // since branchId is not reliably on every existing token claim).
      // Managers-in-scope and kiosk also read; writes are CF-only.
      match /leaderboards/{branchId} {
        allow get: if (kioskCanRead(tenantId) && branchId == request.auth.token.branchId)
          || (isSignedIn() && getTenantId() == tenantId && (
               isAgent()
                 ? callerBranchId(tenantId) == branchId
                 : canManage(tenantId)
             ));
        allow list: if (kioskCanRead(tenantId) && branchId == request.auth.token.branchId)
          || (isSignedIn() && getTenantId() == tenantId && (
               isAgent()
                 ? callerBranchId(tenantId) == branchId
                 : canManage(tenantId)
             ));
        allow write: if false;
      }

      // Track J P5-prep: tenant-wide weekly champions doc (precomputed by the
      // leaderboard-aggregate CF via Admin SDK). One doc per completed week;
      // doc-id is the YYYY-MM-DD Sunday. Shape (matches the retired
      // `WeeklyChampionsBanner`'s `champions` prop):
      //   { topAPI, topApps, topActivity, weekStarting, computedAt }
      // where each top-* is { agentId, agentName, value } | null.
      //
      // Read: any signed-in tenant member (agents + managers + kiosk). Scope
      // is TENANT-WIDE — there is no branch arm, mirroring the retired
      // `gamification/Leaderboard` banner that read all-tenant submissions.
      // Write: CF-only (Admin SDK bypasses rules).
      match /weeklyChampions/{weekStarting} {
        allow get:  if kioskCanRead(tenantId)
          || (isSignedIn() && getTenantId() == tenantId);
        allow list: if kioskCanRead(tenantId)
          || (isSignedIn() && getTenantId() == tenantId);
        allow write: if false;
      }

      // Tier-3 #15: per-branch kiosk rotation config. A manager toggles which
      // static rotation panels are shown on the wall; the kiosk display reads
      // its OWN branch's config (doc-id == branchId) to skip disabled panels.
      // Unlike agentOfMonth (CF/Admin write), this is a CLIENT-side manager
      // write, so it is subject to these rules. Read mirrors the branch-scoped
      // kiosk arm (doc-id vs token.branchId, as in /leaderboards); write mirrors
      // the branches/kioskTokens canManage arm plus field validation:
      //   - exactly { disabledPanels, updatedBy, updatedAt }
      //   - updatedBy == caller uid
      //   - disabledPanels is a list, size-capped, drawn only from the known
      //     kioskConfig.js PANEL_ORDER keys (rejects non-string / unknown keys).
      match /kioskConfig/{branchId} {
        allow get: if canManage(tenantId)
          || (kioskCanRead(tenantId) && branchId == request.auth.token.branchId);
        allow write: if canManage(tenantId)
          && request.resource.data.keys().hasOnly(['disabledPanels', 'updatedBy', 'updatedAt'])
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.disabledPanels is list
          && request.resource.data.disabledPanels.size() <= 13
          && request.resource.data.disabledPanels.hasOnly([
               'welcome', 'agentOfMonth', 'branchOverview', 'branchRunningTotals',
               'unitLeaderboard', 'lastWeekRecap', 'ytdLeaderboards', 'qtdLeaderboards',
               'mtdLeaderboards', 'weekLeaderboards', 'weeklyActivity', 'awardsWatch',
               'compliance'
             ]);
      }

      // F1 (Track F): coaching notes — manager-chain private, agent EXCLUDED.
      //
      // Privacy model: rank-based visibility chain.
      //   authorRoleRank denormalized on each note (UM=1, BM=2, SM=3, TA=4, PA=5).
      //   A caller can read/write only notes authored by someone at or below their rank.
      //   This means UM notes are visible to UM+BM+SM+TA+PA; SM notes to SM+TA+PA only.
      //
      // Scope: unit_manager is restricted to notes where agentUnitId == their uid.
      //   branch_manager and above are tenant-scoped (mirrors the submissions pattern).
      //   Peer-BM exclusion (BM reading notes on an agent in another branch) is a
      //   known limitation — branch-scoped infra not yet built. See FOLLOW_UPS.md.
      //
      // No canAccessOwn branch — the agent NEVER reads their own coaching notes.
      match /users/{agentId}/coachingNotes/{noteId} {

        function cnUMScopeOk() {
          return getRole() != 'unit_manager'
              || resource.data.agentUnitId == request.auth.uid;
        }

        function cnUMScopeOnWrite() {
          return getRole() != 'unit_manager'
              || request.resource.data.agentUnitId == request.auth.uid;
        }

        allow get: if isManager()
          && getTenantId() == tenantId
          && cnUMScopeOk()
          && roleRank() >= resource.data.authorRoleRank;

        // list: evaluated per-document; client MUST include authorRoleRank <= callerRank
        // filter (and agentUnitId == uid for unit_manager). Rule enforces same predicate
        // so unscoped list queries are rejected.
        allow list: if isManager()
          && getTenantId() == tenantId
          && (getRole() != 'unit_manager' || resource.data.agentUnitId == request.auth.uid)
          && roleRank() >= resource.data.authorRoleRank;

        allow create: if isManager()
          && getTenantId() == tenantId
          && cnUMScopeOnWrite()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRoleRank == roleRank()
          && request.resource.data.tenantId == tenantId
          && request.resource.data.agentId == agentId
          && request.resource.data.category in
               ['observation', 'goal', 'concern', 'win', 'action_item']
          && request.resource.data.keys().hasAll([
               'agentId', 'tenantId', 'agentUnitId', 'authorUid',
               'authorName', 'authorRole', 'authorRoleRank', 'category',
               'body', 'createdAt', 'updatedAt'
             ]);

        // update: author may edit their own note body/category/isPinned only (no rank change, no delete).
        allow update: if isManager()
          && getTenantId() == tenantId
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['body', 'category', 'isPinned', 'updatedAt'])
          && request.resource.data.category in
               ['observation', 'goal', 'concern', 'win', 'action_item'];

        allow delete: if false;
      }

      // F3 (Track F): prospect-info — agent-authored, manager-chain READABLE.
      //
      // Privacy model: SUBMISSIONS-style (NOT F1/F2's exclusion).
      //   - Agent owns/reads/edits OWN records (request.auth.uid == path agentId).
      //   - Managers in scope READ; managers do NOT write.
      //
      // Scope: unit_manager restricted to docs where agentUnitId == their uid;
      //   branch_manager and above tenant-scoped (mirrors the submissions rule).
      //
      // Path-bound: {agentId} appears in path, so agent-own checks compare the
      //   path segment to request.auth.uid directly (no resource.data lookup).
      //
      // Inversion vs F1/F2: NOT rank-based, NOT agent-excluded. The agent IS
      //   the author and CAN read their own. Managers CANNOT write.
      match /users/{agentId}/prospectInfo/{prospectId} {

        // get: agent reads own (path agentId == uid), OR manager reads in scope.
        allow get: if isSignedIn() && getTenantId() == tenantId && (
          request.auth.uid == agentId
          || (isManager() && (
               getRole() != 'unit_manager'
               || resource.data.agentUnitId == request.auth.uid
             ))
        );

        // list: agent lists own (path agentId == uid), OR manager lists in scope.
        // For UM the rule enforces agentUnitId == request.auth.uid per-doc, so
        // the client query MUST include where('agentUnitId','==',callerUid).
        allow list: if isSignedIn() && getTenantId() == tenantId && (
          request.auth.uid == agentId
          || (isManager() && (
               getRole() != 'unit_manager'
               || resource.data.agentUnitId == request.auth.uid
             ))
        );

        // create: agent-only, must match path agentId. Managers DENIED.
        allow create: if isSignedIn()
          && getTenantId() == tenantId
          && isAgent()
          && request.auth.uid == agentId
          && request.resource.data.agentId == agentId
          && request.resource.data.tenantId == tenantId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.prospectingSource in
               ['seminar', 'booth-event', 'referral', 'cold-call', 'social-media',
                'orphan', 'existing-client', 'family-friend',
                'bank-referral', 'BOA', 'self', 'other']
          && request.resource.data.appointmentType in
               ['2nd-interview', 'closing-interview']
          && request.resource.data.objections is list
          && request.resource.data.keys().hasAll([
               'agentId', 'tenantId', 'agentUnitId', 'createdBy',
               'clientName', 'prospectingSource', 'appointmentType',
               'objections', 'policyType', 'intendedAppointmentDate',
               'createdAt', 'updatedAt'
             ]);

        // update: agent-only, must own path. Body-shape fields only;
        //   never agentId/tenantId/createdBy/agentUnitId/audit timestamps (except updatedAt).
        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && isAgent()
          && request.auth.uid == agentId
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'clientName', 'clientAge', 'clientOccupation',
                 'prospectingSource', 'socialPlatform', 'appointmentType', 'objections',
                 'policyType', 'intendedAppointmentDate', 'updatedAt'
               ])
          && request.resource.data.prospectingSource in
               ['seminar', 'booth-event', 'referral', 'cold-call', 'social-media',
                'orphan', 'existing-client', 'family-friend',
                'bank-referral', 'BOA', 'self', 'other']
          && request.resource.data.appointmentType in
               ['2nd-interview', 'closing-interview']
          && request.resource.data.objections is list;

        // No deletes (agent-immutable history); soft-delete is a future change.
        allow delete: if false;
      }

      // F2 (Track F): joint-call observations — manager-chain private, agent EXCLUDED.
      //
      // Privacy model: identical to F1 coachingNotes (rank-based visibility chain).
      //   authorRoleRank denormalized on each call (UM=1, BM=2, SM=3, TA=4, PA=5).
      //   A caller can read/write only calls authored by someone at or below their rank.
      //
      // Scope: unit_manager is restricted to calls where agentUnitId == their uid.
      //   branch_manager and above are tenant-scoped (mirrors F1).
      //
      // No canAccessOwn branch — the agent NEVER reads their own joint-call observations.
      match /users/{agentId}/jointCalls/{callId} {

        function jcUMScopeOk() {
          return getRole() != 'unit_manager'
              || resource.data.agentUnitId == request.auth.uid;
        }

        function jcUMScopeOnWrite() {
          return getRole() != 'unit_manager'
              || request.resource.data.agentUnitId == request.auth.uid;
        }

        allow get: if isManager()
          && getTenantId() == tenantId
          && jcUMScopeOk()
          && roleRank() >= resource.data.authorRoleRank;

        // list — TWO separate allow declarations (ORed by Firestore, each evaluated independently):
        //
        // 1. Author arm (collectionGroup-safe, I1.2): caller reads their OWN authored calls.
        //    Split into its own allow list so Firestore evaluates it in isolation.
        //    A combined || with arm 2 (which has a path-variable condition) causes production
        //    Firestore to reject the entire expression for collectionGroup queries — it cannot
        //    short-circuit OR when any arm is statically unverifiable. Separate declarations
        //    are each evaluated independently; if arm 1 satisfies the query, access is granted
        //    regardless of arm 2. Tenant isolation is enforced at the query level:
        //    getOwnJfwCount includes where('tenantId','==',tid) and the create-rule invariant
        //    (authorUid pinned + tenantId field == path tenantId) guarantees a uid can only
        //    author docs in its own tenant.
        allow list: if isManager()
          && resource.data.authorUid == request.auth.uid;

        // 2. Upline rank-scoped list (collection-scoped only): upline manager lists an agent's calls.
        //    getTenantId()==tenantId uses a path variable — safe only for COLLECTION queries
        //    (single-agent path). Never used as collectionGroup; the author arm above handles that.
        allow list: if isManager()
          && getTenantId() == tenantId
          && (getRole() != 'unit_manager' || resource.data.agentUnitId == request.auth.uid)
          && roleRank() >= resource.data.authorRoleRank;

        allow create: if isManager()
          && getTenantId() == tenantId
          && jcUMScopeOnWrite()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRoleRank == roleRank()
          && request.resource.data.tenantId == tenantId
          && request.resource.data.agentId == agentId
          && request.resource.data.meetingType in
               ['demonstration', 'observation', 'collaboration']
          && request.resource.data.needCovered in
               ['income_protection', 'mortgage_or_debt', 'education_funding',
                'retirement_planning', 'final_expenses', 'wealth_accumulation',
                'critical_illness_or_health', 'business_protection', 'other']
          && request.resource.data.keys().hasAll([
               'agentId', 'tenantId', 'agentUnitId', 'authorUid',
               'authorName', 'authorRole', 'authorRoleRank',
               'appointmentDate', 'appointmentTime', 'appointmentKept',
               'nextMeetingDate', 'meetingType', 'needCovered',
               'comments', 'saleMade', 'coachingMinutes', 'trainingIdentified',
               'createdAt', 'updatedAt'
             ]);

        // update: author may edit body-shape fields or soft-archive; never authorUid/rank/audit/agent identity.
        allow update: if isManager()
          && getTenantId() == tenantId
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'appointmentDate', 'appointmentTime', 'appointmentKept',
                 'nextMeetingDate', 'meetingType', 'needCovered',
                 'comments', 'saleMade', 'coachingMinutes', 'trainingIdentified',
                 'prospectInfoId', 'archived',
                 'updatedAt'
               ])
          && request.resource.data.meetingType in
               ['demonstration', 'observation', 'collaboration']
          && request.resource.data.needCovered in
               ['income_protection', 'mortgage_or_debt', 'education_funding',
                'retirement_planning', 'final_expenses', 'wealth_accumulation',
                'critical_illness_or_health', 'business_protection', 'other'];

        allow delete: if false;
      }

      // Track I I1.1: Manager Weekly Activity Report.
      // Privacy model (submissions-direction, NOT coaching-notes-direction):
      //   - Owner (the filing manager) creates, updates, and reads their own WAR.
      //   - Upline reads read-only: reader rank strictly > WAR's managerRoleRank,
      //     with BM limited to same branchId; SM+ tenant-wide.
      //     SM=tenant-wide is valid while SM≈head-of-sales in a single-branch org.
      //   - Peers (same/lower rank) and downline agents are DENIED.
      //   - Filers: unit_manager, branch_manager, sales_manager.
      //     tenant_admin / platform_admin read-only; they do not file a WAR.
      // No collectionGroup query and no index in this PR (I1.1).
      // I1.2 adds jfwCount auto-count via collectionGroup + index.
      match /managerWeeklyReports/{warId} {

        // SEC-4 pattern: branchId is not a custom claim; read from Firestore user doc.
        function callerBranchId(tenantId) {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.branchId;
        }

        // Upline-in-scope: strictly greater than to deny peers.
        function uplineCanRead() {
          return roleRank() > resource.data.managerRoleRank
            && (
              getRole() in ['tenant_admin', 'platform_admin', 'sales_manager']
              || (getRole() == 'branch_manager'
                  && callerBranchId(tenantId) == resource.data.branchId)
            );
        }

        // Field-shape validation. jfwCount: on create must be 0; on update client
        // cannot change it (I1.2 auto-count writes via Admin SDK bypassing rules).
        function validWarWrite() {
          let d = request.resource.data;
          return d.managerId == request.auth.uid
            && d.tenantId == tenantId
            && d.keys().hasAll([
                 'managerId', 'tenantId', 'weekStart',
                 'managerRole', 'managerRoleRank', 'branchId', 'unitId',
                 'oneOnOnesConducted', 'namesSourced', 'interviewsConducted',
                 'recruitsInFirstWeeks', 'trainingSessions', 'trainingTopic',
                 'unitMeetingHeld', 'dashboardReviewDone',
                 'jfwCount', 'status', 'updatedAt'
               ])
            && d.oneOnOnesConducted   is int
            && d.namesSourced         is int
            && d.interviewsConducted  is int
            && d.recruitsInFirstWeeks is int
            && d.trainingSessions     is int
            && d.trainingTopic        is string
            && d.dashboardReviewDone  is bool
            && d.unitMeetingHeld      is bool
            && d.jfwCount == (resource == null ? 0 : resource.data.jfwCount)
            && d.status in ['draft', 'submitted']
            && d.weekStart is string
            && d.managerRole in ['unit_manager', 'branch_manager', 'sales_manager']
            && d.managerRoleRank == roleRank()
            // Review fields are reviewer-only (see the upline review arm below).
            // Owner writes must never CONTAIN them — blocks self-approval while
            // still letting a full-setDoc resubmit clear review state by
            // omission (intended semantic: a resubmitted WAR needs re-review).
            && !d.keys().hasAny(['reviewStatus', 'reviewNote', 'reviewedBy', 'reviewedByName', 'reviewedAt']);
        }

        allow create: if isSignedIn()
          && getTenantId() == tenantId
          && getRole() in ['unit_manager', 'branch_manager', 'sales_manager']
          && validWarWrite();

        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && resource.data.managerId == request.auth.uid
          && validWarWrite();

        // Tier-2 2.1 reviewer workflow: an upline manager (same scope as
        // uplineCanRead — strictly higher rank; BM branch-scoped; SM+ tenant-
        // wide) may review a SUBMITTED WAR, touching ONLY the review fields.
        // Separate arm from the owner update (each `allow` evaluates
        // independently). Reviewer identity is pinned to auth.uid.
        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && resource.data.status == 'submitted'
          && uplineCanRead()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reviewStatus', 'reviewNote', 'reviewedBy', 'reviewedByName', 'reviewedAt'])
          && request.resource.data.reviewStatus in ['approved', 'changes_requested']
          && request.resource.data.reviewNote is string
          && request.resource.data.reviewNote.size() <= 2000
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedByName is string
          && request.resource.data.reviewedAt is timestamp;

        // Single-doc: owner (or pre-write existence check via warId prefix) OR upline.
        // resource == null when doc doesn't exist (owner's pre-write getDoc check).
        // Extract managerId from warId (format: {managerId}_{weekStart}) to allow
        // owner existence-check without hitting a null-pointer on resource.data.
        allow get: if isSignedIn()
          && getTenantId() == tenantId
          && (resource == null
              ? warId.split('_')[0] == request.auth.uid
              : resource.data.managerId == request.auth.uid || uplineCanRead());

        // Query-safe list: BM (rank 2) sees own branch; SM+ (rank ≥ 3) sees tenant-wide.
        // UM (rank 1) denied by the roleRank()>=2 gate. roleRank() and
        // callerBranchId() are block-local — no hoisting needed (I1.x FU).
        allow list: if getTenantId() == tenantId
          && roleRank() >= 2
          && (resource.data.branchId == callerBranchId(tenantId) || roleRank() >= 3);

        allow delete: if false;
      }

      // ── I2: manager monthly recruiting roll-up ───────────────────────────────
      // /tenants/{tid}/managerMonthlyRollups/{managerId}_{YYYY_MM}
      // Privacy = WAR direction: owner RW, upline R; peers + downline DENY.
      // callerBranchId + uplineCanRead are block-local (mirror managerWeeklyReports
      // at :651/:656) — they scope tenantId from the surrounding match block.
      // No jfwCount-immutability analog (no CF auto-count for monthly fields).
      match /managerMonthlyRollups/{rollupId} {

        function callerBranchId(tenantId) {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.branchId;
        }

        function uplineCanRead() {
          return roleRank() > resource.data.managerRoleRank
            && (
              getRole() in ['tenant_admin', 'platform_admin', 'sales_manager']
              || (getRole() == 'branch_manager'
                  && callerBranchId(tenantId) == resource.data.branchId)
            );
        }

        function validRollupWrite() {
          let d = request.resource.data;
          return d.managerId == request.auth.uid
            && d.tenantId == tenantId
            && d.keys().hasAll([
                 'managerId', 'tenantId', 'monthKey',
                 'managerRole', 'managerRoleRank', 'branchId', 'unitId',
                 'candidatesAssessed', 'agentsContracted',
                 'status', 'updatedAt'
               ])
            && d.candidatesAssessed is int && d.candidatesAssessed >= 0
            && d.agentsContracted   is int && d.agentsContracted   >= 0
            && d.status in ['draft', 'submitted']
            && d.monthKey is string
            && d.managerRole in ['unit_manager', 'branch_manager', 'sales_manager']
            && d.managerRoleRank == roleRank();
        }

        allow create: if isSignedIn() && getTenantId() == tenantId
          && getRole() in ['unit_manager', 'branch_manager', 'sales_manager']
          && validRollupWrite();

        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && resource.data.managerId == request.auth.uid
          && validRollupWrite();

        // Single-doc: owner (or pre-write existence check via rollupId prefix) OR upline.
        // resource == null when doc doesn't exist (owner's pre-write getDoc check).
        // Extract managerId from rollupId (format: {managerId}_{YYYY-MM}) to allow
        // owner existence-check without hitting a null-pointer on resource.data.
        allow get: if isSignedIn() && getTenantId() == tenantId
          && (resource == null
              ? rollupId.split('_')[0] == request.auth.uid
              : resource.data.managerId == request.auth.uid || uplineCanRead());

        // Query-safe list: BM (rank 2) sees own branch; SM+ (rank ≥ 3) sees tenant-wide.
        // UM (rank 1) denied by the roleRank()>=2 gate.
        allow list: if isSignedIn() && getTenantId() == tenantId
          && roleRank() >= 2
          && (resource.data.branchId == callerBranchId(tenantId) || roleRank() >= 3);

        allow delete: if false;
      }

      // ── Tier-2 2.2: recruiting pipeline candidates (kanban CRM) ──────────────
      // /tenants/{tid}/recruitingCandidates/{candidateId}  (auto-id)
      // Operator ruling: the no-CRM guardrail is LIFTED for this surface only.
      // Ownership: ownerUid = the manager driving the candidate. Creator must
      // self-own; an in-scope senior (BM same-branch / SM+ / TA) may edit and
      // reassign ownerUid (coaching moves). Agents have NO access.
      // Board reads: UM lists own candidates (ownerUid == uid); BM lists own
      // branch; SM+ tenant-wide. Equality-only queries — automatic single-field
      // indexes, NO composite required (client-side sort; boards are tens of
      // docs). No delete: candidates leave the board via status='archived'.
      match /recruitingCandidates/{candidateId} {

        function callerBranchId(tenantId) {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.branchId;
        }

        // BM is branch-scoped; SM/TA/PA tenant-wide. (Managers only — rank ≥ 2
        // per roleRank(); UMs act through ownership, not scope.)
        function seniorInScope() {
          return getRole() in ['tenant_admin', 'platform_admin', 'sales_manager']
            || (getRole() == 'branch_manager'
                && callerBranchId(tenantId) == resource.data.branchId);
        }

        function validCandidateWrite() {
          let d = request.resource.data;
          return d.tenantId == tenantId
            && d.keys().hasAll([
                 'tenantId', 'branchId', 'ownerUid', 'ownerName', 'name',
                 'stage', 'status', 'source', 'referrerName', 'note',
                 'stageChangedAt', 'lastTouchAt', 'createdAt', 'updatedAt'
               ])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 200
            && d.stage in ['sourced', 'contacted', 'seminar', 'interview',
                           'assessment', 'offer', 'licensing', 'licensed']
            && d.status in ['active', 'archived']
            && d.source is string && d.source.size() <= 200
            && d.referrerName is string && d.referrerName.size() <= 200
            && d.note is string && d.note.size() <= 2000
            && d.ownerUid is string && d.ownerName is string
            && d.branchId is string;
        }

        allow create: if isSignedIn()
          && getTenantId() == tenantId
          && getRole() in ['unit_manager', 'branch_manager', 'sales_manager', 'tenant_admin']
          && request.resource.data.ownerUid == request.auth.uid
          && validCandidateWrite();

        // Owner, or an in-scope senior (who may also reassign ownerUid).
        // tenantId + branchId are immutable in v1 (cross-branch transfer is a
        // future ruling); owner edits may not change ownerUid (no self-transfer).
        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && validCandidateWrite()
          && request.resource.data.branchId == resource.data.branchId
          && (
            (resource.data.ownerUid == request.auth.uid
              && request.resource.data.ownerUid == resource.data.ownerUid)
            || seniorInScope()
          );

        allow get: if isSignedIn()
          && getTenantId() == tenantId
          && (resource.data.ownerUid == request.auth.uid || seniorInScope());

        // Query-safe arms, mirroring the WAR/rollup split-arm pattern:
        // UM board: where('ownerUid','==',uid). BM board: where('branchId','==',own).
        // SM+/TA: tenant-wide.
        allow list: if isSignedIn()
          && getTenantId() == tenantId
          && resource.data.ownerUid == request.auth.uid;
        allow list: if isSignedIn()
          && getTenantId() == tenantId
          && getRole() == 'branch_manager'
          && resource.data.branchId == callerBranchId(tenantId);
        allow list: if isSignedIn()
          && getTenantId() == tenantId
          && getRole() in ['sales_manager', 'tenant_admin', 'platform_admin'];

        allow delete: if false;
      }

      // ── Tier-3 3.2: planner appointments (agent Planner + manager Team Planner) ──
      // /tenants/{tid}/appointments/{apptId}  (auto-id)
      // FLAT tenant collection (repo idiom: prospectInfo/policies), NOT the
      // handoff's per-agent subcollection — the Team Planner needs cross-agent
      // queries, and flat + denormalized scope fields avoids collectionGroup
      // rules pitfalls. Owner (agent/producing manager) full write on OWN
      // appointments; upline READ-ONLY (UM own unit, BM own branch, SM+/TA
      // tenant-wide). No hard deletes — cancelled/postponed keep their doc
      // (status flip + rescheduledToId link), per the planner handoff.
      match /appointments/{apptId} {

        function callerBranchId(tenantId) {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.branchId;
        }

        function validApptWrite() {
          let d = request.resource.data;
          return d.tenantId == tenantId
            && d.agentId == request.auth.uid
            && d.keys().hasAll([
                 'tenantId', 'agentId', 'agentUnitId', 'agentBranchId',
                 'date', 'startTime', 'durationMin', 'type', 'status',
                 'note', 'createdAt', 'updatedAt'
               ])
            && d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
            && d.startTime is string
            && d.durationMin is int && d.durationMin > 0 && d.durationMin <= 720
            // 16 keys = TYPE_KEYS in src/services/plannerService.js. These two
            // allowlists (validApptWrite + validTemplateWrite) are the ONLY
            // server-side gate on the type value — they must be extended in the
            // same change as APPOINTMENT_TYPES, and a deploy is required before
            // any new key can be written. A future per-tenant type set cannot be
            // a literal here; see the FUTURE TENANT CONFIG note in plannerService.
            && d.type in ['PC', 'SC', 'AI', 'FFI', 'CI', 'SALE', 'FREE',
                          'PROP', 'PAPER', 'COLL', 'DEL',
                          'SEM', 'TRADE', 'MTG', 'TRAIN', 'ADMIN']
            && d.status in ['scheduled', 'confirmed', 'kept', 'cancelled', 'postponed', 'done']
            && d.note is string && d.note.size() <= 2000
            && (!('apiAmount' in d) || d.apiAmount == null || (d.apiAmount is number && d.apiAmount >= 0))
            // Recurrence metadata (optional; concrete-materialized series). All
            // absent on one-off appointments (backward-compatible).
            && (!('seriesId' in d) || d.seriesId is string)
            && (!('repeatRule' in d) || d.repeatRule in ['daily', 'weekly', 'custom'])
            && (!('daysOfWeek' in d) || d.daysOfWeek is list)
            && (!('seriesPos' in d) || (d.seriesPos is int && d.seriesPos > 0 && d.seriesPos <= 52))
            && (!('seriesTotal' in d) || (d.seriesTotal is int && d.seriesTotal > 0 && d.seriesTotal <= 52));
        }

        allow create: if isSignedIn()
          && getTenantId() == tenantId
          && (isAgent() || isProducingManager())
          && validApptWrite();

        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && resource.data.agentId == request.auth.uid
          && validApptWrite();

        allow get: if isSignedIn()
          && getTenantId() == tenantId
          && (resource.data.agentId == request.auth.uid
              || getRole() in ['sales_manager', 'tenant_admin', 'platform_admin']
              || (getRole() == 'branch_manager'
                  && callerBranchId(tenantId) == resource.data.agentBranchId)
              || (getRole() == 'unit_manager'
                  && resource.data.agentUnitId == request.auth.uid));

        // Query-safe split list arms (mirrors recruitingCandidates):
        allow list: if isSignedIn()
          && getTenantId() == tenantId
          && resource.data.agentId == request.auth.uid;
        allow list: if isSignedIn()
          && getTenantId() == tenantId
          && getRole() == 'unit_manager'
          && resource.data.agentUnitId == request.auth.uid;
        allow list: if isSignedIn()
          && getTenantId() == tenantId
          && getRole() == 'branch_manager'
          && resource.data.agentBranchId == callerBranchId(tenantId);
        allow list: if isSignedIn()
          && getTenantId() == tenantId
          && getRole() in ['sales_manager', 'tenant_admin', 'platform_admin'];

        // Run 9 A1: owner-scoped delete — exists solely as the undo-create inverse;
        // UI exposes no delete affordance.
        allow delete: if isSignedIn()
          && getTenantId() == tenantId
          && resource.data.agentId == request.auth.uid;
      }

      // ── Run 9 A4: reusable appointment templates ──────────────────────────────
      // /tenants/{tid}/appointmentTemplates/{templateId}  (auto-id)
      // A template is a reusable appointment SHAPE (no date / prospect / series).
      // PERSONAL: owner (agent/producing manager) full CRUD on OWN templates;
      // NO manager read arms (unlike appointments — templates are private to the
      // agent). agentId pinned to the caller's uid (forgery-proof). hasOnly locks
      // the doc to exactly the 11 contract keys.
      match /appointmentTemplates/{templateId} {

        function validTemplateWrite() {
          let d = request.resource.data;
          return d.tenantId == tenantId
            && d.agentId == request.auth.uid
            && d.keys().hasOnly([
                 'tenantId', 'agentId', 'name', 'type', 'startTime',
                 'durationMin', 'note', 'createdAt', 'updatedAt',
                 'freeBlockLabel', 'apiAmount'
               ])
            && d.keys().hasAll([
                 'tenantId', 'agentId', 'name', 'type', 'startTime',
                 'durationMin', 'note', 'createdAt', 'updatedAt'
               ])
            && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
            // 16 keys = TYPE_KEYS in src/services/plannerService.js. These two
            // allowlists (validApptWrite + validTemplateWrite) are the ONLY
            // server-side gate on the type value — they must be extended in the
            // same change as APPOINTMENT_TYPES, and a deploy is required before
            // any new key can be written. A future per-tenant type set cannot be
            // a literal here; see the FUTURE TENANT CONFIG note in plannerService.
            && d.type in ['PC', 'SC', 'AI', 'FFI', 'CI', 'SALE', 'FREE',
                          'PROP', 'PAPER', 'COLL', 'DEL',
                          'SEM', 'TRADE', 'MTG', 'TRAIN', 'ADMIN']
            && d.startTime is string && d.startTime.matches('\\d{2}:\\d{2}')
            && d.durationMin is int && d.durationMin > 0 && d.durationMin <= 720
            && d.note is string && d.note.size() <= 2000
            && (!('apiAmount' in d) || d.apiAmount == null || (d.apiAmount is number && d.apiAmount >= 0))
            && (!('freeBlockLabel' in d) || d.freeBlockLabel is string);
        }

        allow create: if isSignedIn()
          && getTenantId() == tenantId
          && (isAgent() || isProducingManager())
          && validTemplateWrite();

        // Update additionally requires the EXISTING doc to be owned by the
        // caller — validTemplateWrite alone validates only the incoming doc,
        // whose agentId an attacker could set to themselves (hijack).
        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && (isAgent() || isProducingManager())
          && resource.data.agentId == request.auth.uid
          && validTemplateWrite();

        // Owner-only reads (personal templates — no upline arms).
        allow get, list: if isSignedIn()
          && getTenantId() == tenantId
          && resource.data.agentId == request.auth.uid;

        allow delete: if isSignedIn()
          && getTenantId() == tenantId
          && resource.data.agentId == request.auth.uid;
      }

      // ── I1.3c-ii: per-manager activity standard overrides ────────────────────
      // /tenants/{tid}/managerActivityStandardOverrides/{managerId}
      // Fields: tenantId, managerId, updatedBy, updatedAt, + partial activity map.
      // NO branchId/role denormalization — rule reads M's real role+branchId via
      // get(M's user doc) to prevent forgery (request.resource.data fields about
      // M are controllable by the writer; resource.data is null on create).
      // get(M) via subjectData(): Firestore caches same-path get() within one
      // rule evaluation, so subjectRank() + subjectBranchId() cost one read.
      match /managerActivityStandardOverrides/{managerId} {

        // Caller's branchId via get() — branchId is not a claim (SEC-4 pattern).
        function callerBranchId(tenantId) {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.branchId;
        }

        // Subject (M)'s real role + branchId from M's user doc.
        // managerId == M's uid (the doc path ID).
        function subjectData() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(managerId)).data;
        }

        function subjectRank() {
          let r = subjectData().role;
          return r == 'unit_manager'   ? 1 :
                 r == 'branch_manager' ? 2 :
                 r == 'sales_manager'  ? 3 : 0;
        }

        function subjectBranchId() {
          return subjectData().branchId;
        }

        // Upline-in-scope: strictly greater rank (denies peers + self); BM branch-scoped.
        function uplineInScope() {
          return roleRank() > subjectRank()
            && (roleRank() >= 3
                || (getRole() == 'branch_manager'
                    && callerBranchId(tenantId) == subjectBranchId()));
        }

        // Owner reads own (uid == managerId — no resource access needed, handles null doc).
        // Upline reads by id when browsing M's WAR. No list rule.
        allow get: if isSignedIn()
          && getTenantId() == tenantId
          && (request.auth.uid == managerId || uplineInScope());

        // Payload managerId + tenantId validated against path/tenant.
        // Subject rank + branch from get(M), NOT request.resource.data — forgery prevention.
        allow create: if isSignedIn()
          && getTenantId() == tenantId
          && request.resource.data.managerId == managerId
          && request.resource.data.tenantId  == tenantId
          && uplineInScope();

        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && uplineInScope();

        // Delete reverts M to org-defaults (clears entire override doc).
        allow delete: if isSignedIn()
          && getTenantId() == tenantId
          && uplineInScope();

        // Read-only list arm for the Company Config override-count indicator
        // (Run 5 DECISIONS-NEEDED #1). tenant_admin in-tenant + platform_admin
        // (cross-tenant by design — matches every other TA/PA read arm, e.g.
        // the config block ~line 657). Managers + agents still DENY. The
        // forgery-prevention write arms above are unchanged.
        allow list: if isSignedIn()
          && getRole() in ['platform_admin', 'tenant_admin']
          && (getRole() == 'platform_admin' || getTenantId() == tenantId);
      }

      // ── Weekly Planner v2 Slice 2: agent-set committed weekly plan ────────────
      // /tenants/{tid}/weeklyPlans/{agentId}_{weekStart}  (weekStart = YYYY-MM-DD Sunday)
      //
      // Agent owns full CRUD on OWN doc only (isAgent() denies managers incl. TA/PA
      // from writing/deleting — "no manager write"). Upline GET mirrors the moneyNeeds
      // sibling's cross-doc-lookup scoping (UM same-unit, BM same-branch, SM/TA/PA
      // tenant-wide) MINUS the visibility gate — plans are unconditionally upline-
      // readable, like submissions. NO list arm / NO composite index this slice:
      // every read is a deterministic-ID get. S4's manager roll-up is a get-fan-out
      // over the roster ({agentId}_{weekStart} per member), each get authorized by
      // the upline arm here — still no list, still no index.
      //
      // Rules enforce SECURITY + SHAPE only: ownership, exact key sets (hasOnly+hasAll
      // on all three: top-level / targets / provenance), int ≥0 targets, provenance
      // enums, tenant match, timestamp types, weekStart immutability on update, and
      // the planId date-segment format. The resolved-floor MINIMUM (tenure-resolved,
      // JS-side) is enforced by the stepper clamp + weeklyPlanService re-validation,
      // NOT here. Sunday semantics + ID-date == weekStart consistency also live in the
      // service (validateSundayDate / parseDateOnlyTT).
      match /weeklyPlans/{planId} {

        function validPlanWrite() {
          let d = request.resource.data;
          return d.agentId == request.auth.uid
            && d.tenantId == tenantId
            && planId.split('_').size() == 2
            && planId.split('_')[0] == request.auth.uid
            && planId.split('_')[1].matches('\\d{4}-\\d{2}-\\d{2}')
            && d.keys().hasAll(['agentId','tenantId','weekStart','targets','provenance',
                                'anchorAPIAtCommit','committedAt','updatedAt'])
            && d.keys().hasOnly(['agentId','tenantId','weekStart','targets','provenance',
                                 'anchorAPIAtCommit','committedAt','updatedAt'])
            && d.weekStart is timestamp
            && d.committedAt is timestamp
            && d.updatedAt is timestamp
            && (d.anchorAPIAtCommit == null || d.anchorAPIAtCommit is number)
            && d.targets.keys().hasAll(['callsMade','telContacts','factFindsCompleted',
                                        'closingInterviewsKept','applicationsSubmitted'])
            && d.targets.keys().hasOnly(['callsMade','telContacts','factFindsCompleted',
                                         'closingInterviewsKept','applicationsSubmitted'])
            && d.targets.callsMade             is int && d.targets.callsMade             >= 0
            && d.targets.telContacts           is int && d.targets.telContacts           >= 0
            && d.targets.factFindsCompleted    is int && d.targets.factFindsCompleted    >= 0
            && d.targets.closingInterviewsKept is int && d.targets.closingInterviewsKept >= 0
            && d.targets.applicationsSubmitted is int && d.targets.applicationsSubmitted >= 0
            && d.provenance.keys().hasAll(['callsMade','telContacts','factFindsCompleted',
                                           'closingInterviewsKept','applicationsSubmitted'])
            && d.provenance.keys().hasOnly(['callsMade','telContacts','factFindsCompleted',
                                            'closingInterviewsKept','applicationsSubmitted'])
            && d.provenance.callsMade             in ['derived','floor','agent']
            && d.provenance.telContacts           in ['derived','floor','agent']
            && d.provenance.factFindsCompleted    in ['derived','floor','agent']
            && d.provenance.closingInterviewsKept in ['derived','floor','agent']
            && d.provenance.applicationsSubmitted in ['derived','floor','agent'];
        }

        // Upline scoping via cross-doc lookup of the agent's user doc (no denormalized
        // unitId/branchId on the plan — the roster integrity probe confirmed those
        // fields are clean, so the lookup is fail-closed-safe). agentId from planId.
        function uplineCanReadPlan() {
          let agentId = planId.split('_')[0];
          return canManage(tenantId) && (
            getRole() in ['sales_manager','tenant_admin','platform_admin']
            || (getRole() == 'unit_manager'
                && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(agentId)).data.unitId == callerUnitId(tenantId))
            || (getRole() == 'branch_manager'
                && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(agentId)).data.branchId == callerBranchId(tenantId))
          );
        }

        allow create: if (isAgent() || isProducingManager()) && getTenantId() == tenantId && validPlanWrite();

        // weekStart is the week's identity — re-commit overwrites targets, never the week.
        allow update: if (isAgent() || isProducingManager()) && getTenantId() == tenantId
          && resource.data.agentId == request.auth.uid
          && request.resource.data.weekStart == resource.data.weekStart
          && validPlanWrite();

        // Single-doc get: owner (incl. pre-write null-resource prefix check) OR upline.
        // Non-owners get NO existence oracle — when the doc is absent (resource == null)
        // only the owner-prefix arm can succeed; managers must hit an existing doc.
        allow get: if isSignedIn() && getTenantId() == tenantId
          && (resource == null
              ? planId.split('_')[0] == request.auth.uid
              : resource.data.agentId == request.auth.uid || uplineCanReadPlan());

        allow delete: if (isAgent() || isProducingManager()) && getTenantId() == tenantId
          && resource.data.agentId == request.auth.uid;

        // No list arm by design (see header). S4 stays get-fan-out, no index.
      }

      // G5: Money Needs Worksheet — agent-own + manager-read arms (opt-in consent model).
      // True-ownership: uid match only. No canAccessOwn (avoids TA/PA blanket-read).
      // TA and platform_admin have no read arm — moneyNeeds is agent-private by design.
      match /users/{uid}/moneyNeeds/{year} {
        // Owner: strict uid match (no TA/PA elevation)
        allow get, list: if isSignedIn() && getTenantId() == tenantId && request.auth.uid == uid;

        // UM: read if shared AND same unit
        allow get, list: if canManage(tenantId)
          && getRole() == 'unit_manager'
          && resource.data.visibility == 'shared'
          && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(uid)).data.unitId == callerUnitId(tenantId);

        // BM: read if shared AND same branch
        allow get, list: if canManage(tenantId)
          && getRole() == 'branch_manager'
          && resource.data.visibility == 'shared'
          && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(uid)).data.branchId == callerBranchId(tenantId);

        // SM: read if shareWithSm (tenant-wide)
        allow get, list: if canManage(tenantId)
          && getRole() == 'sales_manager'
          && resource.data.shareWithSm == true;

        // Create: agent or producing manager, must start private, own uid only
        allow create: if (isAgent() || isProducingManager()) && getTenantId() == tenantId && request.auth.uid == uid
          && request.resource.data.visibility == 'private';

        // Update: owner only (agent controls visibility and shareWithSm)
        allow update: if isSignedIn() && getTenantId() == tenantId && request.auth.uid == uid;

        allow delete: if false;
      }

      // Year Plan — agent-own annual production plan (Game Plan Step 2).
      // Owner writes; get is owner OR upline (Fork B1 manager-review slice).
      match /users/{uid}/yearPlan/{year} {
        // Fork B1 — unconditional upline read, ruled 2026-07-03; mirrors weeklyPlans,
        // deliberately NO visibility gate (moneyNeeds keeps the opt-in). Owner uid is
        // the PATH variable — no planId.split (user subcollection, unlike the flat
        // weeklyPlans collection). TA/PA route through canManage's role elevation
        // (PA tokens carry tenantId: null, so an outer token-tenant gate would
        // wrongly deny them); UM/BM/SM stay tenant-bound inside canManage.
        function uplineCanReadUserPlan() {
          return canManage(tenantId) && (
            getRole() in ['sales_manager','tenant_admin','platform_admin']
            || (getRole() == 'unit_manager'
                && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(uid)).data.unitId == callerUnitId(tenantId))
            || (getRole() == 'branch_manager'
                && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(uid)).data.branchId == callerBranchId(tenantId))
          );
        }
        // PR-U2: coarse additive field constraints (Option 2). Keys stay
        // permissive — the {life,ah,general} taxonomy is enforced in the data
        // layer (LINE_KEYS in yearPlanService), not duplicated here. Rules can't
        // iterate list elements, so the constraints are deliberately coarse:
        // per-known-line `rate ∈ [0,1]` (when present) and `products` a list of
        // ≤4 (when present). Deep per-product field validation stays in the
        // saveYearPlan sanitizer. All arms are guarded by `'x' in line` so a
        // write omitting the additive fields still passes (additive, not required).
        // `is map` guards precede every `in` — in CEL, `in` on a non-map throws an
        // evaluation error; the guard makes a malformed write a graceful DENY.
        function validYearPlanLine(line) {
          return line is map
            && (!('rate' in line) || (line.rate is number && line.rate >= 0 && line.rate <= 1))
            && (!('products' in line) || (line.products is list && line.products.size() <= 4));
        }
        function validYearPlanLines(data) {
          return !('lines' in data) || (
            data.lines is map
            && (!('life' in data.lines)    || validYearPlanLine(data.lines.life))
            && (!('ah' in data.lines)      || validYearPlanLine(data.lines.ah))
            && (!('general' in data.lines) || validYearPlanLine(data.lines.general))
          );
        }
        // Single-doc get: owner OR upline. Existence-oracle guard mirrors weeklyPlans:
        // the upline arm requires an EXISTING doc (resource != null) — managers get
        // deny, not not-found, on absent docs. The owner arm is path-uid-based, so
        // it needs no existence branch (unlike weeklyPlans' ID-prefix split).
        allow get: if isSignedIn()
          && ((getTenantId() == tenantId && request.auth.uid == uid)
              || (resource != null && uplineCanReadUserPlan()));
        // LIST stays owner-only — manager reads are deterministic-ID get-fan-out
        // (no manager list arm, no composite index, no collectionGroup wildcard).
        allow list: if isSignedIn() && getTenantId() == tenantId && request.auth.uid == uid;
        allow create: if (isAgent() || isProducingManager()) && getTenantId() == tenantId && request.auth.uid == uid
          && request.resource.data.status == 'draft'
          && validYearPlanLines(request.resource.data);
        allow update: if isSignedIn() && getTenantId() == tenantId && request.auth.uid == uid
          && validYearPlanLines(request.resource.data);
        allow delete: if false;
      }

      // Monthly Plan — agent-own monthly breakdown of the year plan (Game Plan Step 3).
      // Owner writes, mirroring the yearPlan arm; get is owner OR upline (Fork B1).
      // No UI writes this path until the gated Slice-2 panel.
      match /users/{uid}/monthlyPlan/{year} {
        // Fork B1 — unconditional upline read, ruled 2026-07-03; mirrors weeklyPlans,
        // deliberately NO visibility gate (moneyNeeds keeps the opt-in). Same shape
        // as the yearPlan sibling above — owner uid is the PATH variable.
        function uplineCanReadUserPlan() {
          return canManage(tenantId) && (
            getRole() in ['sales_manager','tenant_admin','platform_admin']
            || (getRole() == 'unit_manager'
                && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(uid)).data.unitId == callerUnitId(tenantId))
            || (getRole() == 'branch_manager'
                && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(uid)).data.branchId == callerBranchId(tenantId))
          );
        }
        // Single-doc get: owner OR upline, with the weeklyPlans existence-oracle
        // guard — the upline arm requires an EXISTING doc (resource != null);
        // the owner arm is path-uid-based and needs no existence branch.
        allow get: if isSignedIn()
          && ((getTenantId() == tenantId && request.auth.uid == uid)
              || (resource != null && uplineCanReadUserPlan()));
        // LIST stays owner-only — manager reads are deterministic-ID get-fan-out
        // (no manager list arm, no composite index, no collectionGroup wildcard).
        allow list: if isSignedIn() && getTenantId() == tenantId && request.auth.uid == uid;
        allow create: if (isAgent() || isProducingManager()) && getTenantId() == tenantId && request.auth.uid == uid
          && request.resource.data.status == 'draft';
        allow update: if isSignedIn() && getTenantId() == tenantId && request.auth.uid == uid;
        allow delete: if false;
      }

      // Plan Suggestions — manager→agent suggest-back loop (Fork B3). An upline
      // reader of an agent's plan (yearPlan/monthlyPlan, Fork B1 arms) may raise a
      // plan-level suggestion; the AGENT acknowledges it (open→seen). Suggestions
      // are advice — the agent still commits their own plan. Sibling of yearPlan/
      // monthlyPlan/prospectInfo under the users/{uid} tree.
      //
      // Non-deterministic doc IDs (addDoc auto-id) → reads are LIST, not get-fan-out
      // (unlike yearPlan). LIST is therefore agent-own OR upline — path-scoped,
      // orderBy(createdAt desc) single-field (NO composite index, NO collectionGroup).
      match /users/{uid}/planSuggestions/{suggestionId} {
        // Fork B1 helper reused VERBATIM (mirrors the yearPlan/monthlyPlan copies —
        // block-scoped, owner uid is the PATH variable). canManage(tenantId) carries
        // tenant scoping (PA elevates through it); UM/BM stay unit/branch-bound.
        function uplineCanReadUserPlan() {
          return canManage(tenantId) && (
            getRole() in ['sales_manager','tenant_admin','platform_admin']
            || (getRole() == 'unit_manager'
                && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(uid)).data.unitId == callerUnitId(tenantId))
            || (getRole() == 'branch_manager'
                && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(uid)).data.branchId == callerBranchId(tenantId))
          );
        }

        // get: owner (path uid), OR an upline reader. The upline arm requires an
        // EXISTING doc (resource != null) — mirrors the yearPlan existence-oracle
        // guard so managers get a clean not-found, not a permission leak, on absent.
        allow get: if isSignedIn() && (
          (getTenantId() == tenantId && request.auth.uid == uid)
          || (resource != null && uplineCanReadUserPlan())
        );
        // list: owner (path uid), OR an upline reader (both the agent's hub card and
        // the manager drawer read this list). Each result doc exists, so no
        // existence-oracle branch is needed. Path-scoped + single-field orderBy →
        // index-free; NO composite index, NO collectionGroup wildcard.
        allow list: if isSignedIn() && (
          (getTenantId() == tenantId && request.auth.uid == uid)
          || uplineCanReadUserPlan()
        );

        // create: an upline reader raises a suggestion on the agent (symmetric with
        // the read arm — any upline reader, not only UM). raisedByUid PINNED to the
        // caller (financingEscalations precedent); agentId/tenantId path-bound;
        // status 'open'; seenAt null; NOT the agent (no self-suggestions — belt-and-
        // suspenders over canManage). Exact key set (hasAll + hasOnly) = the locked
        // ten fields, nothing else. Type guards mirror financingEscalations' string/
        // timestamp guards (a non-string note/name would break display + ordering).
        // Cheap literal checks first; uplineCanReadUserPlan() (a document get())
        // is evaluated LAST so a self-create / malformed write short-circuits to
        // DENY without paying for the read (&& is left-to-right short-circuit).
        allow create: if request.auth.uid != uid
          && request.resource.data.raisedByUid == request.auth.uid
          && request.resource.data.agentId == uid
          && request.resource.data.tenantId == tenantId
          && request.resource.data.status == 'open'
          && request.resource.data.seenAt == null
          && request.resource.data.agentId is string
          && request.resource.data.year is int
          && request.resource.data.note is string
          && request.resource.data.raisedByName is string
          && request.resource.data.raisedByRole is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasAll([
               'tenantId', 'agentId', 'year', 'note', 'raisedByUid',
               'raisedByName', 'raisedByRole', 'status', 'createdAt', 'seenAt'
             ])
          && request.resource.data.keys().hasOnly([
               'tenantId', 'agentId', 'year', 'note', 'raisedByUid',
               'raisedByName', 'raisedByRole', 'status', 'createdAt', 'seenAt'
             ])
          && uplineCanReadUserPlan();

        // update: the AGENT-ONLY ack (open→seen). Field-restricted to the ack pair
        // (SEC-10 hasOnly precedent); strict open→seen (no re-ack — resource must be
        // open); managers never update (auth.uid == uid is the agent). seenAt pinned
        // to a real timestamp.
        allow update: if isSignedIn()
          && getTenantId() == tenantId
          && request.auth.uid == uid
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'seenAt'])
          && request.resource.data.status == 'seen'
          && request.resource.data.seenAt is timestamp;

        allow delete: if false;
      }

      // User app preferences (Nav redesign PR-2) — owner-only, no manager arm.
      // Single doc `prefs/app` = { pinnedNav: string[], updatedAt }. Written with
      // { merge: true }; PR-4 adds `menuLayout` to the SAME doc, so this owner
      // block already permits that write (no PR-4 rules change). Owner gating
      // mirrors the moneyNeeds/yearPlan arm: strict uid match, tenant-scoped.
      match /users/{uid}/prefs/{prefId} {
        allow read, write: if isSignedIn() && getTenantId() == tenantId && request.auth.uid == uid;
      }

      // ── Compliance v2 Slice 2: manager-initiated filing nudges ────────────────
      // /tenants/{tid}/nudges/{audienceUid}_{type}_{weekStart}
      //   weekStart = YYYY-MM-DD Sunday; type = 'compliance.filing.nudge' (dotted,
      //   no underscores) — so split('_')[0] is the audienceUid.
      //
      // CF-only writes: the sendComplianceNudge Cloud Function is the sole writer
      // (Admin SDK bypasses these rules). NO client create/update. The nudge doc
      // is the dedupe/cooldown RECORD (deterministic ID + SET-MERGE re-nudge).
      // delete: the creating manager only (smoke cleanup + a future retract
      // affordance; the audit trail survives in auditNudges regardless).
      // get: the audience (agent) reads own, OR an upline manager — the
      // deterministic-ID GET powers the manager cooldown chip, index-free,
      // mirroring uplineCanReadPlan. Both get arms derive audienceUid from the
      // doc ID, so an ABSENT nudge (resource == null) still authorizes an upline
      // GET → a clean not-found for the chip rather than permission-denied.
      // NO list arm (no index; the agent-inbox feature, if ever, adds it later).
      match /nudges/{nudgeId} {

        function uplineCanReadNudge() {
          let audienceUid = nudgeId.split('_')[0];
          return canManage(tenantId) && (
            getRole() in ['sales_manager','tenant_admin','platform_admin']
            || (getRole() == 'unit_manager'
                && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(audienceUid)).data.unitId == callerUnitId(tenantId))
            || (getRole() == 'branch_manager'
                && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(audienceUid)).data.branchId == callerBranchId(tenantId))
          );
        }

        // CF-only: no client create/update.
        allow create, update: if false;

        // Creator (the nudging manager) may delete.
        allow delete: if isSignedIn() && getTenantId() == tenantId
          && resource.data.createdBy == request.auth.uid;

        // Single-doc get: audience reads own (ID prefix) OR upline.
        allow get: if isSignedIn() && getTenantId() == tenantId
          && (nudgeId.split('_')[0] == request.auth.uid || uplineCanReadNudge());

        // No list arm by design (see header).
      }

      // Compliance v2 Slice 2: nudge audit log — written exclusively by the
      // sendComplianceNudge Cloud Function via Admin SDK (rules bypass). Clients
      // never read or write; the audit trail survives nudge-doc deletion.
      match /auditNudges/{docId} {
        allow read, write: if false;
      }

      // ── Track K · K10b: financing escalations (UM → same-branch BM) ────────────
      // Flat collection /tenants/{tid}/financingEscalations/{escalationId}
      //   ID = {agentId}_{reason}_{YYYY_MM} (idempotent per agent+reason+month).
      //
      // A Unit Manager raises a TRACKED escalation on one of their OWN-unit agents'
      // financing; the SAME-BRANCH Branch Manager (and SM/TA/PA) reads an inbox and
      // ACKS it. States: 'open' → 'acknowledged'. The agent is excluded entirely.
      //
      // UNRELATED to functions/war/escalationLogic.js (WAR missed-standard upline
      //   notify) — different concept, no shared symbols.
      //
      // Read key: resource.data.branchId (the agent's branchId, denormalized at
      //   create) == callerBranchId(tenantId). branchId completeness verified in
      //   real pilot data (K10b Phase 1 probe: tatillife_smoke 6/6, south 12/12).
      // Index: financingEscalations (branchId ASC, status ASC, createdAt DESC).
      //
      // branchId-denorm trust (K10c): the create arm now get()-binds the
      //   denormalized branchId AND unitId to the RAISED agent's real user doc, so
      //   a UM can neither misroute an escalation to another branch's BM nor raise
      //   on an agent outside their own unit (both were pre-K10c residuals). See
      //   raisedAgent() below and the two get()-binding clauses on the create arm.
      match /financingEscalations/{escalationId} {

        // K10c get()-binding: read the RAISED agent's real user doc (keyed on the
        //   escalation's request.resource.data.agentId) to bind the denormalized
        //   unitId/branchId against ground truth. Mirrors the persistency block's
        //   newDocAgentBranchId() precedent (get() on request.resource.data.agentId,
        //   firestore.rules ~L515) and the callerBranchId()/callerUnitId() get()-on-
        //   user-doc helpers (~L59/L64). A single get() serves BOTH bindings below —
        //   Firestore dedupes repeated get()s of the same document within one rule
        //   evaluation, so the branchId + unitId checks cost one document read total.
        //   Fail-closed: if the agent doc (or a bound field) is absent, the field
        //   read is null and every equality comparison against it is false → DENY.
        function raisedAgent() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.resource.data.agentId)).data;
        }

        // Who may READ an escalation: SM/TA/PA tenant-wide, or a BM whose own
        // branchId matches the doc's denormalized branchId. UM has NO read arm;
        // agent excluded. On `update` this reads resource.data (the pre-ack doc),
        // so the branch check keys on the existing branchId — correct.
        function canReadEscalation() {
          return isManager() && getTenantId() == tenantId && (
            getRole() in ['sales_manager', 'tenant_admin', 'platform_admin']
            || (getRole() == 'branch_manager'
                && callerBranchId(tenantId) != null
                && resource.data.branchId == callerBranchId(tenantId))
          );
        }

        allow get: if canReadEscalation();
        // list: per-doc predicate identical to get. The BM inbox query MUST filter
        // where('branchId','==',callerBranchId); SM/TA/PA may list tenant-wide.
        allow list: if canReadEscalation();

        // create: UM only, on an OWN-unit agent (agentUnitId == uid, mirrors
        //   coachingNotes cnUMScopeOnWrite), self-stamped raiser, status 'open',
        //   reason in enum, full key set present, tenantId == path tenant.
        allow create: if isSignedIn()
          && getTenantId() == tenantId
          && getRole() == 'unit_manager'
          && request.resource.data.agentUnitId == request.auth.uid
          && request.resource.data.raisedByUid == request.auth.uid
          && request.resource.data.tenantId == tenantId
          && request.resource.data.status == 'open'
          && request.resource.data.reason in
               ['draw_decision', 'confirm_request', 'notify_5_3', 'termination_risk']
          && request.resource.data.keys().hasAll([
               'tenantId', 'agentId', 'agentName', 'agentUnitId', 'branchId',
               'raisedByUid', 'raisedByName', 'raisedByRole', 'reason', 'note',
               'status', 'createdAt'
             ])
          // Type guards (mirrors sibling K-track collections): a non-string
          // branchId/createdAt would break the BM inbox where/orderBy.
          && request.resource.data.agentId is string
          && request.resource.data.agentName is string
          && request.resource.data.branchId is string
          && request.resource.data.raisedByName is string
          && request.resource.data.raisedByRole is string
          && request.resource.data.note is string
          && request.resource.data.createdAt is timestamp
          // K10c get()-bindings — bind the denormalized unitId/branchId to the
          //   RAISED agent's real user doc (one get(), deduped for both checks):
          //   1. unitId: the agent must actually belong to the raising UM's unit.
          //      The prior arm bound agentUnitId == auth.uid but NEVER checked the
          //      agent truly sits in that unit — a UM could raise on ANY agentId
          //      while stamping their own uid as agentUnitId. This closes that hole.
          //   2. branchId: the denormalized branchId must equal the agent's real
          //      branchId — a UM can no longer misroute an escalation to another
          //      branch's BM inbox. Fail-closed: a null field → false → DENY.
          && raisedAgent().unitId == request.auth.uid
          && request.resource.data.branchId == raisedAgent().branchId;

        // update: the ACK, by a caller who may read the escalation. Field-restricted
        //   to the ack triple (SEC-10 hasOnly precedent); new status must be
        //   'acknowledged'; the acknowledger is PINNED to the caller (no forging who
        //   acked — mirrors coachingNotes authorUid == auth.uid). This also blocks a
        //   UM same-month re-raise (a full-field setDoc onto an existing doc fails
        //   hasOnly and canReadEscalation).
        allow update: if canReadEscalation()
          && resource.data.status == 'open'                    // strict open→acknowledged; no re-ack
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'acknowledgedByUid', 'acknowledgedAt'])
          && request.resource.data.status == 'acknowledged'
          && request.resource.data.acknowledgedByUid == request.auth.uid;

        allow delete: if false;
      }

    }

    // ── I1.2: collectionGroup author arm for jointCalls ───────────────────────
    // Firestore collectionGroup query security requires a top-level recursive
    // wildcard match; path-specific rules (match /tenants/.../jointCalls/{id})
    // are not reliably evaluated for collectionGroup queries. This rule handles
    // ONLY the author-arm list (manager reads their own authored calls via the
    // getOwnJfwCount collectionGroup query). All other jointCalls operations
    // (get, create, update, delete, upline list) remain governed by the specific
    // path rule inside match /tenants/{tenantId}/users/{agentId}/jointCalls/{callId}.
    //
    // Tenant isolation: enforced at query level — getOwnJfwCount always includes
    // where('tenantId','==',tenantId). The create-rule invariant (authorUid pinned
    // + tenantId field == path tenantId) guarantees a manager can only author docs
    // in their own tenant, providing defense-in-depth against cross-tenant reads.
    match /{path=**}/jointCalls/{callId} {
      allow list: if isManager()
        && resource.data.authorUid == request.auth.uid;
    }

  }
}
