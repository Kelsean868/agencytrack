# Verification artifacts (PDFs, screenshots, exploration reports)
# Use verification/* (not verification/) so a11y scan archives can be re-included
verification/*
!verification/a11y/
!verification/a11y/*.json
!verification/a11y/screenshots/
!verification/a11y/screenshots/*.png
!verification/mobile/
!verification/mobile/**
!verification/e4/
!verification/e4/results.json
!verification/e4/screenshots/
!verification/e4/screenshots/*.png
# Track J — screenshot atlas baselines (committed; future dated atlases replace, not accumulate)
!verification/atlas-*/
!verification/atlas-*/**

# codebase-memory-mcp — local graph cache (opt-in artifact, not committed for solo repo)
.codebase-memory/

# Playwright MCP local state
.playwright-mcp/

# Playwright browser cache and test artifacts
test-results/
playwright-report/

# Session handoff notes — local context for the next chat session
.session-handoffs/

# Firebase extension config — may contain SMTP credentials, API keys
extensions/*.env
extensions/*.env.*
extensions/*.secret.local
extensions/secrets/
scripts/verification/emails-v2-rendered/

# Track J item 24 — verification screenshot outputs + ad-hoc capture noise.
# Smoke/probe scripts under scripts/verification/ stay tracked; their PNG
# outputs do not. ui_screenshots/ + ui_capture_script.js were a one-off atlas
# precursor (superseded by scripts/verification/screenshot-atlas.mjs);
# batch-report.md is an ephemeral generated report.
scripts/verification/*.png
/ui_screenshots/
/ui_capture_script.js
/batch-report.md

# Graphify — volatile/machine-specific outputs (tracked: graph.html, GRAPH_REPORT.md, .graphify_labels.json)
# graph.json excluded: exceeds GitHub's 100 MB file size limit (generated at 147.89 MB)
graphify-out/graph.json
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/????-??-??/

